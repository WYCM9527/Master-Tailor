{
  "slug": "thread-lines",
  "name": "细丝波浪",
  "category": "background",
  "sub": "idle",
  "tags": [
    "细线",
    "波浪",
    "WebGL",
    "着色器",
    "氛围"
  ],
  "summary": "几十根发光细丝拧成一束横贯画面，端头收拢、尾部散开地波动",
  "params": [
    {
      "key": "color",
      "label": "丝线颜色",
      "type": "color",
      "target": "config",
      "default": "#ffffff"
    },
    {
      "key": "lineCount",
      "label": "丝线数量",
      "type": "range",
      "target": "config",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 40
    },
    {
      "key": "amplitude",
      "label": "波动幅度",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "spread",
      "label": "散开程度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0,
      "help": "0 拧成一束，1 均匀铺满纵向"
    },
    {
      "key": "mouse",
      "label": "鼠标扰动",
      "type": "toggle",
      "target": "config",
      "default": false
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "loose",
      "name": "散开丝幕",
      "values": {
        "spread": 0.8,
        "lineCount": 50,
        "amplitude": 1.6
      }
    },
    {
      "id": "gold",
      "name": "金丝",
      "values": {
        "color": "#d9b36c",
        "amplitude": 0.7,
        "lineCount": 30
      }
    }
  ],
  "thumb": {
    "mode": "live"
  },
  "source": {
    "kind": "visual-inspiration"
  }
}
