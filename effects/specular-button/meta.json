{
  "slug": "specular-button",
  "name": "镜面高光按钮",
  "category": "button",
  "sub": "hover",
  "tags": ["按钮", "镜面", "高光", "WebGL", "鼠标交互"],
  "summary": "透明按钮的边缘挂着两段对称的镜面细光，光的方向追着鼠标转，靠近才亮",
  "params": [
    { "key": "label", "label": "按钮文字", "type": "text", "target": "config", "default": "立即开始", "maxLength": 16 },
    {
      "key": "radius",
      "label": "圆角",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    { "key": "lineColor", "label": "高光颜色", "type": "color", "target": "config", "default": "#ffffff" },
    { "key": "baseColor", "label": "边线底色", "type": "color", "target": "config", "default": "#525252" },
    {
      "key": "intensity",
      "label": "高光强度",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "shineSize",
      "label": "高光段长",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 60,
      "step": 2,
      "default": 10,
      "unit": "°",
      "help": "以角度计的高光核心宽度"
    },
    {
      "key": "shineFade",
      "label": "高光羽化",
      "type": "range",
      "target": "config",
      "min": 5,
      "max": 90,
      "step": 5,
      "default": 40,
      "unit": "°"
    },
    {
      "key": "thickness",
      "label": "光线粗细",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 4,
      "step": 0.5,
      "default": 1,
      "unit": "px"
    },
    {
      "key": "speed",
      "label": "闲置转速",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 2,
      "step": 0.05,
      "default": 0.35,
      "help": "没有鼠标时光角自转的速度"
    },
    {
      "key": "autoAnimate",
      "label": "常亮自转",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "关闭后只有鼠标靠近才亮起"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "gold", "name": "金边", "values": { "lineColor": "#ffd27a", "baseColor": "#5a4a2a", "shineSize": 20, "thickness": 1.5 } },
    { "id": "proximity", "name": "靠近才亮", "values": { "autoAnimate": false, "intensity": 1.6 } }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
