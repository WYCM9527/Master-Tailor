{
  "slug": "specular-button",
  "name": "镜面高光按钮",
  "category": "button",
  "sub": "hover",
  "tags": ["按钮", "高光", "镜面"],
  "summary": "按钮像一块抛光金属，一团高光始终追着鼠标在表面滑动",
  "params": [
    {
      "key": "label",
      "label": "按钮文字",
      "type": "text",
      "target": "config",
      "default": "立即开始",
      "maxLength": 12
    },
    { "key": "base", "label": "按钮底色", "type": "color", "target": "css", "default": "#1c1c1c" },
    { "key": "text", "label": "文字颜色", "type": "color", "target": "css", "default": "#ffffff" },
    { "key": "light", "label": "高光颜色", "type": "color", "target": "css", "default": "#ffffff" },
    {
      "key": "size",
      "label": "高光大小",
      "type": "range",
      "target": "css",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 140,
      "unit": "px"
    },
    {
      "key": "intensity",
      "label": "高光强度",
      "type": "range",
      "target": "css",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    },
    {
      "key": "edge",
      "label": "边缘描光",
      "type": "toggle",
      "target": "css",
      "default": true,
      "help": "边框上也跟着亮起一段"
    },
    {
      "key": "rounded",
      "label": "圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12,
      "unit": "px"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "pill",
      "name": "白胶囊",
      "values": {
        "base": "#ffffff",
        "text": "#0a0a0f",
        "light": "#a3a3a3",
        "rounded": 40,
        "intensity": 0.6
      }
    },
    {
      "id": "tight",
      "name": "小亮点",
      "values": { "size": 70, "intensity": 0.9, "edge": false, "rounded": 4 }
    }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
