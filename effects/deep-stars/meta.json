{
  "slug": "deep-stars",
  "name": "深空星河",
  "category": "background",
  "sub": "hover",
  "tags": ["星空", "星河", "WebGL", "着色器", "鼠标交互"],
  "summary": "四层景深的星河缓缓旋转，星星闪着十字光芒，鼠标推开身边的星",
  "params": [
    {
      "key": "density",
      "label": "星星密度",
      "type": "range",
      "target": "config",
      "min": 0.4,
      "max": 2,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "hueShift",
      "label": "色相偏移",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 360,
      "step": 10,
      "default": 140,
      "unit": "°"
    },
    {
      "key": "saturation",
      "label": "星色饱和",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0,
      "help": "0 近乎白星，1 彩色星"
    },
    {
      "key": "glow",
      "label": "光芒强度",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 0.3,
      "help": "星星十字光芒的长度"
    },
    {
      "key": "twinkle",
      "label": "闪烁强度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.3
    },
    {
      "key": "speed",
      "label": "时间速度",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "rotationSpeed",
      "label": "旋转速度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 0.5,
      "step": 0.05,
      "default": 0.1
    },
    { "key": "mouseRepel", "label": "鼠标推开星星", "type": "toggle", "target": "config", "default": true },
    {
      "key": "repelStrength",
      "label": "推开力度",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "default": 2
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "colorful", "name": "彩色星云", "values": { "saturation": 0.8, "hueShift": 220, "twinkle": 0.5 } },
    { "id": "dense", "name": "繁星如尘", "values": { "density": 1.8, "glow": 0.15, "rotationSpeed": 0.05 } }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
