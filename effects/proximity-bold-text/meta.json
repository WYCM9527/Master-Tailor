{
  "slug": "proximity-bold-text",
  "name": "靠近加粗文字",
  "category": "text",
  "sub": "hover",
  "tags": ["悬停", "加粗", "磁场"],
  "summary": "鼠标靠近哪几个字，它们就鼓起来变粗变大，像被放大镜压过",
  "params": [
    {
      "key": "text",
      "label": "文案",
      "type": "text",
      "target": "config",
      "default": "靠近我 · PRESSURE · 感受重量",
      "maxLength": 40
    },
    {
      "key": "radius",
      "label": "感应半径",
      "type": "range",
      "target": "config",
      "min": 40,
      "max": 300,
      "step": 10,
      "default": 140,
      "unit": "px"
    },
    {
      "key": "grow",
      "label": "最大放大",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 2,
      "step": 0.05,
      "default": 1.45,
      "help": "鼠标正压在字上时字放大的倍数"
    },
    {
      "key": "weight",
      "label": "同时变粗",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "靠近时字重从细变粗（字体需支持多字重）"
    },
    {
      "key": "lightUp",
      "label": "同时提亮",
      "type": "toggle",
      "target": "config",
      "default": true
    },
    {
      "key": "damping",
      "label": "跟随阻尼",
      "type": "range",
      "target": "config",
      "min": 0.05,
      "max": 0.5,
      "step": 0.05,
      "default": 0.18,
      "help": "越小越黏、越滞后；越大越跟手"
    },
    { "key": "color", "label": "文字颜色", "type": "color", "target": "css", "default": "#a3a3a3" },
    {
      "key": "accent",
      "label": "提亮颜色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    {
      "key": "fontSize",
      "label": "字号",
      "type": "range",
      "target": "css",
      "min": 24,
      "max": 96,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    { "key": "font", "label": "字体", "type": "font", "target": "css", "default": "noto-sans-sc" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "wide",
      "name": "大磁场轻放大",
      "values": { "radius": 260, "grow": 1.2, "damping": 0.1 }
    },
    {
      "id": "punch",
      "name": "重压",
      "values": { "radius": 90, "grow": 1.9, "damping": 0.35, "font": "smiley-sans" }
    }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
