{
  "slug": "twist-pillar",
  "name": "扭转光柱",
  "category": "background",
  "sub": "idle",
  "tags": ["光柱", "扭转", "WebGL", "着色器", "氛围"],
  "summary": "画面中央立着一根由无数光丝拧成的光柱，上紫下粉，缓缓旋转、向上涌动",
  "params": [
    { "key": "topColor", "label": "顶部颜色", "type": "color", "target": "config", "default": "#5227ff" },
    { "key": "bottomColor", "label": "底部颜色", "type": "color", "target": "config", "default": "#ff9ffc" },
    {
      "key": "intensity",
      "label": "整体亮度",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "rotationSpeed",
      "label": "旋转与涌动速度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 1.5,
      "step": 0.05,
      "default": 0.3
    },
    {
      "key": "glow",
      "label": "发光量",
      "type": "range",
      "target": "config",
      "min": 0.001,
      "max": 0.02,
      "step": 0.001,
      "default": 0.005,
      "help": "越大光丝越糊成一团亮"
    },
    {
      "key": "pillarWidth",
      "label": "柱体粗细",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 8,
      "step": 0.5,
      "default": 3
    },
    {
      "key": "pillarHeight",
      "label": "光丝拉伸",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 0.4,
      "help": "越小光丝越被纵向拉长"
    },
    {
      "key": "noise",
      "label": "颗粒",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 0.5
    },
    {
      "key": "tilt",
      "label": "整体倾斜",
      "type": "range",
      "target": "config",
      "min": -90,
      "max": 90,
      "step": 5,
      "default": 0,
      "unit": "°"
    },
    { "key": "interactive", "label": "鼠标控制旋转", "type": "toggle", "target": "config", "default": false }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "cyan", "name": "青金", "values": { "topColor": "#12d7ff", "bottomColor": "#ffd166", "pillarWidth": 2 } },
    { "id": "beam", "name": "横向光带", "values": { "tilt": 90, "pillarHeight": 0.25, "glow": 0.008 } }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
