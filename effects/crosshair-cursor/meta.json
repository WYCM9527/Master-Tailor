{
  "slug": "crosshair-cursor",
  "name": "十字瞄准线",
  "category": "canvas",
  "sub": "hover",
  "tags": [
    "光标",
    "瞄准",
    "线条"
  ],
  "summary": "整屏十字瞄准线跟着鼠标走，指到目标时中心让开一圈、线条被电流打了一下似地抖动",
  "params": [
    {
      "key": "lag",
      "label": "跟随迟滞",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 0.35,
      "help": "1 为完全跟手，越小线越慢半拍"
    },
    {
      "key": "gap",
      "label": "中心留空",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12,
      "unit": "px",
      "help": "十字交叉处断开的半径"
    },
    {
      "key": "hoverGap",
      "label": "指到目标时留空",
      "type": "range",
      "target": "config",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 40,
      "unit": "px"
    },
    {
      "key": "coords",
      "label": "显示坐标",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "在交叉点旁显示鼠标坐标读数"
    },
    {
      "key": "color",
      "label": "线条颜色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    {
      "key": "opacity",
      "label": "线条透明度",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "default": 0.6
    },
    {
      "key": "accent",
      "label": "目标高亮色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "sniper",
      "name": "狙击镜",
      "values": {
        "lag": 1,
        "gap": 0,
        "hoverGap": 60,
        "opacity": 1,
        "coords": true
      }
    },
    {
      "id": "soft",
      "name": "柔和慢随",
      "values": {
        "lag": 0.15,
        "gap": 24,
        "opacity": 0.3,
        "coords": false
      }
    }
  ],
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration"
  }
}
