{
  "slug": "rainbow-prism",
  "name": "彩虹棱镜",
  "category": "background",
  "sub": "idle",
  "tags": [
    "棱镜",
    "彩虹",
    "WebGL",
    "着色器",
    "氛围"
  ],
  "summary": "一座发光的彩虹棱锥立在黑场中央，光谱沿棱面缓缓流动",
  "params": [
    {
      "key": "animation",
      "label": "动画方式",
      "type": "select",
      "target": "config",
      "options": [
        {
          "value": "rotate",
          "label": "光谱流动"
        },
        {
          "value": "3drotate",
          "label": "立体自转"
        },
        {
          "value": "hover",
          "label": "跟随鼠标倾斜"
        }
      ],
      "default": "rotate"
    },
    {
      "key": "height",
      "label": "棱锥高度",
      "type": "range",
      "target": "config",
      "min": 1.5,
      "max": 6,
      "step": 0.5,
      "default": 3.5
    },
    {
      "key": "baseWidth",
      "label": "锥底宽度",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 9,
      "step": 0.5,
      "default": 5.5
    },
    {
      "key": "scale",
      "label": "画面缩放",
      "type": "range",
      "target": "config",
      "min": 1.5,
      "max": 6,
      "step": 0.1,
      "default": 3.6
    },
    {
      "key": "glow",
      "label": "发光强度",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "colorFreq",
      "label": "光谱密度",
      "type": "range",
      "target": "config",
      "min": 0.3,
      "max": 3,
      "step": 0.1,
      "default": 1,
      "help": "越大彩虹条纹越密"
    },
    {
      "key": "hueShift",
      "label": "色相旋转",
      "type": "range",
      "target": "config",
      "min": -3.2,
      "max": 3.2,
      "step": 0.1,
      "default": 0
    },
    {
      "key": "timeScale",
      "label": "时间速度",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "default": 0.5
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "spin",
      "name": "立体自转",
      "values": {
        "animation": "3drotate",
        "timeScale": 0.8
      }
    },
    {
      "id": "tall",
      "name": "高塔",
      "values": {
        "height": 5.5,
        "baseWidth": 3,
        "colorFreq": 1.6
      }
    }
  ],
  "thumb": {
    "mode": "live"
  },
  "source": {
    "kind": "visual-inspiration"
  }
}
