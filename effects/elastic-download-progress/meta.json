{
  "slug": "elastic-download-progress",
  "name": "弹性下载进度",
  "category": "progress",
  "sub": "button",
  "tags": ["下载", "按钮变形", "弹性", "橡皮筋", "气泡", "进度"],
  "summary": "圆形下载按钮拉成一根线，进度点走过时把线压弯，百分比气泡跟着晃，下完线弹几下绷直",
  "params": [
    {
      "key": "duration",
      "label": "下载时长",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 12,
      "step": 0.5,
      "default": 5,
      "displayUnit": " 秒"
    },
    {
      "key": "elastic",
      "label": "弹性",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.6,
      "help": "越大线越软，变形与回弹越多"
    },
    {
      "key": "depth",
      "label": "下压深度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 18,
      "displayUnit": "px",
      "help": "进度点在线中间时把线压下去多深"
    },
    {
      "key": "wobble",
      "label": "气泡晃动",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 2,
      "step": 0.1,
      "default": 1,
      "displayUnit": "×",
      "help": "气泡随速度前后摇摆的幅度"
    },
    {
      "key": "hold",
      "label": "完成停留",
      "type": "range",
      "target": "config",
      "min": 0.6,
      "max": 4,
      "step": 0.1,
      "default": 1.6,
      "displayUnit": " 秒",
      "help": "完成后停多久再收回成按钮"
    },
    {
      "key": "file",
      "label": "文件名",
      "type": "text",
      "target": "config",
      "default": "设计稿合集.zip",
      "maxLength": 16
    },
    {
      "key": "width",
      "label": "线长",
      "type": "range",
      "target": "css",
      "min": 200,
      "max": 560,
      "step": 10,
      "default": 360,
      "unit": "px"
    },
    {
      "key": "color",
      "label": "主色",
      "type": "color",
      "target": "css",
      "default": "#6c5ce7"
    },
    {
      "key": "track",
      "label": "轨道色",
      "type": "color",
      "target": "css",
      "default": "#d9d8e8"
    },
    {
      "key": "success",
      "label": "完成色",
      "type": "color",
      "target": "css",
      "default": "#20b26b"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "taut", "name": "紧绷", "values": { "elastic": 0.15, "depth": 8, "wobble": 0.4 } },
    { "id": "soft", "name": "软弹", "values": { "elastic": 0.95, "depth": 30, "wobble": 1.6 } },
    { "id": "coral", "name": "珊瑚", "values": { "color": "#ff6b6b" } }
  ],
  "thumb": { "mode": "autoplay" },
  "source": {
    "kind": "visual-inspiration",
    "name": "Codrops · Elastic Progress",
    "url": "https://tympanus.net/codrops/2015/09/23/elastic-progress/",
    "license": "未使用其代码"
  }
}
