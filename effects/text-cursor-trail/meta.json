{
  "slug": "text-cursor-trail",
  "name": "文字光标拖尾",
  "category": "canvas",
  "sub": "hover",
  "tags": ["光标", "拖尾", "文字", "符号"],
  "summary": "鼠标身后拖着一小串沿着移动方向排列的符号，停下来就从尾巴一个个收走",
  "params": [
    {
      "key": "text",
      "label": "拖尾符号",
      "type": "text",
      "target": "config",
      "default": "⚛️",
      "maxLength": 12,
      "help": "一个字、一个词或一个 emoji"
    },
    {
      "key": "spacing",
      "label": "间距",
      "type": "range",
      "target": "config",
      "min": 40,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px"
    },
    {
      "key": "maxPoints",
      "label": "最多几个",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 15,
      "step": 1,
      "default": 5
    },
    { "key": "followDirection", "label": "随移动方向旋转", "type": "toggle", "target": "config", "default": true },
    { "key": "randomFloat", "label": "在位轻晃", "type": "toggle", "target": "config", "default": true },
    {
      "key": "exitDuration",
      "label": "收走时长",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 1.5,
      "step": 0.05,
      "default": 0.5,
      "unit": "s"
    },
    {
      "key": "removalInterval",
      "label": "收走间隔",
      "type": "range",
      "target": "config",
      "min": 10,
      "max": 300,
      "step": 10,
      "default": 30,
      "displayUnit": " 毫秒",
      "help": "停手后每隔多久从尾巴收走一个"
    },
    { "key": "color", "label": "文字颜色", "type": "color", "target": "css", "default": "#f2f3f8" },
    {
      "key": "fontSize",
      "label": "字号",
      "type": "range",
      "target": "css",
      "min": 16,
      "max": 72,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    { "key": "font", "label": "字体", "type": "font", "target": "css", "default": "system-sans" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "word", "name": "词语拖尾", "values": { "text": "HELLO", "spacing": 120, "maxPoints": 6, "fontSize": 28 } },
    { "id": "stars", "name": "长星串", "values": { "text": "✦", "spacing": 50, "maxPoints": 12, "removalInterval": 15, "randomFloat": false } }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
