{
  "slug": "animated-list",
  "name": "滚入列表",
  "category": "loading",
  "sub": "scroll",
  "tags": ["列表", "进场", "滚动", "键盘"],
  "summary": "一列条目滚进视野时逐个放大浮现，两端渐隐；支持上下键选中并自动滚到可见",
  "params": [
    {
      "key": "items",
      "label": "条目",
      "type": "text",
      "target": "config",
      "default": "晨间新闻｜产品更新｜团队周报｜设计评审｜用户反馈｜发布计划｜数据周报｜市场动态｜招聘进展｜财务简报｜季度目标｜年度回顾",
      "help": "用「｜」分隔"
    },
    {
      "key": "duration",
      "label": "浮现时长",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 0.8,
      "step": 0.05,
      "default": 0.2,
      "unit": "s"
    },
    {
      "key": "fromScale",
      "label": "起始缩放",
      "type": "range",
      "target": "config",
      "min": 0.4,
      "max": 1,
      "step": 0.05,
      "default": 0.7
    },
    { "key": "showGradients", "label": "两端渐隐", "type": "toggle", "target": "config", "default": true },
    { "key": "keyboardNav", "label": "键盘选中", "type": "toggle", "target": "config", "default": true },
    { "key": "itemBg", "label": "条目底色", "type": "color", "target": "css", "default": "#222222" },
    { "key": "selectedBg", "label": "选中底色", "type": "color", "target": "css", "default": "#333333" },
    { "key": "textColor", "label": "文字颜色", "type": "color", "target": "css", "default": "#ffffff" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "slow", "name": "慢浮现", "values": { "duration": 0.5, "fromScale": 0.5 } },
    { "id": "light", "name": "浅色条", "values": { "itemBg": "#f2f2f5", "selectedBg": "#dfe3ff", "textColor": "#111111" } }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
