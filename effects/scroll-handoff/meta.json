{
  "category": "transition",
  "sub": "scroll",
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration",
    "name": "apple.com 产品长页"
  },
  "slug": "scroll-handoff",
  "name": "滚动接力长页",
  "tags": ["转场", "滚动", "长页", "sticky"],
  "summary": "大图钉住、文字浮现，下一节整幅顶上接走上一节",
  "params": [
    {
      "key": "slides",
      "label": "分节图片",
      "type": "images",
      "target": "config",
      "min": 2,
      "max": 6,
      "captions": true,
      "default": [
        {
          "src": "/samples/sample-4.webp",
          "caption": "山谷晨光"
        },
        {
          "src": "/samples/sample-3.webp",
          "caption": "日落海滩"
        },
        {
          "src": "/samples/sample-8.webp",
          "caption": "城市夜色"
        },
        {
          "src": "/samples/sample-5.webp",
          "caption": "蓝天夹竹桃"
        }
      ]
    },
    {
      "key": "pace",
      "label": "每节滚动行程",
      "type": "range",
      "target": "css",
      "min": 120,
      "max": 260,
      "step": 10,
      "default": 180,
      "unit": "",
      "displayUnit": "%",
      "help": "每一节占容器高度的比例，越大这一节钉得越久"
    },
    {
      "key": "rise",
      "label": "文案上浮距离",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 36,
      "unit": "px"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "linger",
      "name": "慢节奏",
      "values": {
        "pace": 240,
        "rise": 52
      }
    },
    {
      "id": "brisk",
      "name": "快节奏",
      "values": {
        "pace": 130,
        "rise": 20
      }
    }
  ]
}
