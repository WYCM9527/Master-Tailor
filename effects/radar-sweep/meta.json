{
  "slug": "radar-sweep",
  "name": "雷达扫描",
  "category": "background",
  "sub": "hover",
  "tags": ["雷达", "扫描", "WebGL", "着色器", "鼠标交互"],
  "summary": "一圈圈同心环不断向外扩散，辐条放射，一道柔光束绕着圆心旋转，鼠标一动整盘轻轻视差",
  "params": [
    { "key": "color", "label": "雷达颜色", "type": "color", "target": "config", "default": "#27ff64" },
    {
      "key": "speed",
      "label": "圆环外扩速度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "scale",
      "label": "盘面缩放",
      "type": "range",
      "target": "config",
      "min": 0.3,
      "max": 1.5,
      "step": 0.05,
      "default": 0.5,
      "help": "越小盘面越大"
    },
    {
      "key": "ringCount",
      "label": "圆环数",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 30,
      "step": 1,
      "default": 10
    },
    {
      "key": "spokeCount",
      "label": "辐条数",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 36,
      "step": 1,
      "default": 10
    },
    {
      "key": "ringThickness",
      "label": "圆环粗细",
      "type": "range",
      "target": "config",
      "min": 0.01,
      "max": 0.3,
      "step": 0.01,
      "default": 0.05
    },
    {
      "key": "sweepSpeed",
      "label": "光束转速",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 4,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "sweepWidth",
      "label": "光束收窄",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 12,
      "step": 0.5,
      "default": 2,
      "help": "越大光束越窄越锐"
    },
    {
      "key": "falloff",
      "label": "边缘衰减",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 6,
      "step": 0.5,
      "default": 2
    },
    { "key": "mouse", "label": "鼠标视差", "type": "toggle", "target": "config", "default": true }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "amber", "name": "琥珀细环", "values": { "color": "#ffb340", "ringCount": 18, "ringThickness": 0.03, "sweepWidth": 6 } },
    { "id": "big", "name": "满屏大盘", "values": { "scale": 0.32, "spokeCount": 16, "falloff": 1 } }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
