{
  "category": "showcase",
  "sub": "carousel",
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration",
    "name": "小红书笔记多图横滑（通用移动端模式）",
    "url": "https://www.xiaohongshu.com",
    "license": "未使用其代码"
  },
  "slug": "multi-image-carousel",
  "name": "多图横滑（笔记风）",
  "tags": [
    "轮播",
    "横滑",
    "分数角标"
  ],
  "summary": "竖版笔记的多图横滑：1/5 角标 + 小圆点，到头回弹",
  "params": [
    {
      "key": "slides",
      "label": "图片列表",
      "type": "images",
      "target": "config",
      "min": 2,
      "max": 9,
      "captions": false,
      "default": [
        {
          "src": "/samples/sample-1.webp",
          "caption": ""
        },
        {
          "src": "/samples/sample-2.webp",
          "caption": ""
        },
        {
          "src": "/samples/sample-3.webp",
          "caption": ""
        },
        {
          "src": "/samples/sample-4.webp",
          "caption": ""
        },
        {
          "src": "/samples/sample-5.webp",
          "caption": ""
        }
      ]
    },
    {
      "key": "duration",
      "label": "滑动时长",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 1.2,
      "step": 0.05,
      "default": 0.35,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "edgeResist",
      "label": "到头阻力",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 0.6,
      "step": 0.05,
      "default": 0.3,
      "help": "滑到第一张/最后一张再拖时的橡皮筋阻力，越小越拖不动"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#f9cf00"
    },
    {
      "key": "rounded",
      "label": "容器圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 12,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "snappy",
      "name": "跟手快滑",
      "values": {
        "duration": 0.25,
        "edgeResist": 0.15
      }
    },
    {
      "id": "soft",
      "name": "松弛慢滑",
      "values": {
        "duration": 0.5,
        "edgeResist": 0.5,
        "accent": "#ff4d6d"
      }
    }
  ]
}
