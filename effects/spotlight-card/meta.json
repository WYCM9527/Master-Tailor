  "params": [
    { "key": "titles", "label": "卡片标题", "type": "text", "target": "config", "default": "极速｜安全｜开放", "help": "用「｜」分隔，一张卡一个" },
    {
      "key": "descs",
      "label": "卡片描述",
      "type": "text",
      "target": "config",
      "default": "毫秒级响应，随时可用｜端到端加密，数据只属于你｜开放接口，与任何工具协作",
      "help": "用「｜」分隔，与标题一一对应"
    },
    { "key": "spotColor", "label": "聚光颜色", "type": "color", "target": "config", "default": "#ffffff" },
    {
