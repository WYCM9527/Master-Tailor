    {
      "key": "intensity",
      "label": "亮起程度",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 1,
      "step": 0.1,
      "default": 0.6,
      "help": "鼠标进入后柔光层的整体透明度"
    },
    { "key": "cardBg", "label": "卡片底色", "type": "color", "target": "css", "default": "#111111" },
    { "key": "borderColor", "label": "边框颜色", "type": "color", "target": "css", "default": "#222222" },
    {
      "key": "radius",
      "label": "圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 24,
      "unit": "px"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "cyan", "name": "青光", "values": { "spotColor": "#00e5ff", "spotAlpha": 0.35, "cardBg": "#0a1218" } },
    { "id": "warm", "name": "暖光纸卡", "values": { "spotColor": "#ffd28a", "spotAlpha": 0.3, "cardBg": "#1a1410", "borderColor": "#2e261c", "radius": 12 } }
