      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    {
      "key": "rounded",
      "label": "容器圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 14,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "reveal-left",
      "name": "先看一小条",
      "values": {
        "startPos": 15
      }
    },
    {
      "id": "thin-cyan",
      "name": "细线青色",
      "values": {
        "lineWidth": 2,
        "accent": "#00e5ff",
        "startPos": 60
      }
    }
  ],
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "original"
