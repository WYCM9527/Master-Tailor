{
  "slug": "ring-text-spin",
  "name": "环形旋转文字",
  "category": "text",
  "sub": "idle",
  "tags": [
    "环形",
    "旋转",
    "印章"
  ],
  "summary": "一圈文字沿圆环缓缓转动，像一枚会转的印章徽标",
  "params": [
    {
      "key": "text",
      "label": "环上文字",
      "type": "text",
      "target": "config",
      "default": "MASTER TAILOR · 裁缝大师 · ",
      "maxLength": 60,
      "help": "会首尾相接绕成一圈，建议以分隔符结尾"
    },
    {
      "key": "radius",
      "label": "圆环半径",
      "type": "range",
      "target": "config",
      "min": 60,
      "max": 200,
      "step": 10,
      "default": 110,
      "unit": "px"
    },
    {
      "key": "period",
      "label": "转一圈用时",
      "type": "range",
      "target": "css",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 16,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "direction",
      "label": "旋转方向",
      "type": "select",
      "target": "css",
      "options": [
        {
          "value": "normal",
          "label": "顺时针"
        },
        {
          "value": "reverse",
          "label": "逆时针"
        }
      ],
      "default": "normal"
    },
    {
      "key": "hoverMode",
      "label": "鼠标悬停时",
      "type": "select",
      "target": "config",
      "options": [
        {
          "value": "fast",
          "label": "加速（×4）"
        },
        {
          "value": "slow",
          "label": "放慢（÷2）"
        },
        {
          "value": "pause",
          "label": "暂停"
        },
        {
          "value": "bonkers",
          "label": "狂转（×20）"
        },
        {
          "value": "none",
          "label": "不变"
        }
      ],
      "default": "fast"
    },
    {
      "key": "center",
      "label": "中心标记",
      "type": "toggle",
      "target": "css",
      "default": true,
      "help": "圆心放一个小方块作为徽标锚点"
    },
    {
      "key": "color",
      "label": "文字颜色",
      "type": "color",
      "target": "css",
      "default": "#f2f3f8"
    },
    {
      "key": "fontSize",
      "label": "字号",
      "type": "range",
      "target": "css",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 18,
      "unit": "px"
    },
    {
      "key": "font",
      "label": "字体",
      "type": "font",
      "target": "css",
      "default": "jetbrains-mono"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "stamp",
      "name": "大印章",
      "values": {
        "radius": 170,
        "fontSize": 24,
        "period": 24,
        "text": "限时发售 · LIMITED EDITION · 2026 · ",
        "font": "smiley-sans"
      }
    },
    {
      "id": "spin",
      "name": "快转逆时针",
      "values": {
        "period": 6,
        "direction": "reverse",
        "hoverMode": "pause",
        "center": false
      }
    }
  ],
  "thumb": {
    "mode": "live"
  },
  "source": {
    "kind": "visual-inspiration"
  }
}
