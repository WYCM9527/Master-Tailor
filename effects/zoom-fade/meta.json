{
  "category": "transition",
  "sub": "zoom",
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration",
    "name": "macOS 启动台 / visionOS 空间过渡"
  },
  "slug": "zoom-fade",
  "name": "缩放淡入转场",
  "tags": ["转场", "缩放", "macOS", "View Transitions"],
  "summary": "新页居中缩放淡入、旧页放大退后，镜头往前推一步的过渡",
  "params": [
    {
      "key": "duration",
      "label": "转场时长",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 0.7,
      "step": 0.05,
      "default": 0.3,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "zoomFrom",
      "label": "新页起始缩放",
      "type": "range",
      "target": "css",
      "min": 0.8,
      "max": 1,
      "step": 0.01,
      "default": 0.92,
      "unit": "",
      "help": "新页从这个倍率放大到 1，越小登场感越强"
    },
    {
      "key": "zoomOut",
      "label": "旧页退场缩放",
      "type": "range",
      "target": "css",
      "min": 1,
      "max": 1.2,
      "step": 0.01,
      "default": 1.04,
      "unit": "",
      "help": "旧页淡出时放大到这个倍率，制造镜头前推的感觉"
    },
    {
      "key": "blur",
      "label": "进出场模糊",
      "type": "toggle",
      "target": "css",
      "default": false,
      "help": "开启后进出场两端带轻微模糊，气质接近 visionOS"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "vision",
      "name": "空间感",
      "values": {
        "duration": 0.45,
        "zoomFrom": 0.88,
        "blur": true
      }
    },
    {
      "id": "snappy",
      "name": "快切",
      "values": {
        "duration": 0.25,
        "zoomFrom": 0.96,
        "zoomOut": 1.02
      }
    }
  ]
}
