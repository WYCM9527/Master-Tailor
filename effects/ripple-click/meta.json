{
  "slug": "ripple-click",
  "name": "点击涟漪",
  "category": "button",
  "trigger": "click",
  "tags": ["点击反馈", "微交互"],
  "summary": "点击按钮时从点击处扩散出一圈水波涟漪",
  "params": [
    { "key": "label", "label": "按钮文字", "type": "text", "target": "config", "default": "点我试试", "maxLength": 12 },
    { "key": "color", "label": "按钮底色", "type": "color", "target": "css", "default": "#26283a" },
    { "key": "rippleColor", "label": "涟漪颜色", "type": "color", "target": "css", "default": "#f9cf00" },
    {
      "key": "duration",
      "label": "扩散时长",
      "type": "range",
      "target": "css",
      "min": 0.3,
      "max": 1.5,
      "step": 0.05,
      "default": 0.6,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "fromCenter",
      "label": "始终从中心扩散",
      "type": "toggle",
      "target": "config",
      "default": false,
      "help": "关闭时从点击位置扩散"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "cyan-fast",
      "name": "青色快波",
      "values": { "rippleColor": "#00e5ff", "duration": 0.4, "color": "#0c2530" }
    },
    {
      "id": "center-slow",
      "name": "中心慢波",
      "values": { "fromCenter": true, "duration": 1.1, "rippleColor": "#ff9e42" }
    }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "original" }
}
