{
  "slug": "prismatic-burst",
  "name": "棱镜爆发",
  "category": "background",
  "sub": "hover",
  "tags": ["光线", "棱镜", "光线步进", "WebGL2"],
  "summary": "从画面深处向你炸开无数彩虹色的光线，像穿过棱镜的白光被撕成光谱，整团缓缓翻转、可随鼠标转向",
  "params": [
    {
      "key": "intensity",
      "label": "亮度",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 5,
      "step": 0.25,
      "default": 2
    },
    {
      "key": "speed",
      "label": "速度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 2,
      "step": 0.05,
      "default": 0.5
    },
    {
      "key": "animationType",
      "label": "运动方式",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "rotate3d", "label": "三维翻转" },
        { "value": "rotate", "label": "平面旋转" },
        { "value": "hover", "label": "跟随鼠标转向" }
      ],
      "default": "rotate3d"
    },
    {
      "key": "distort",
      "label": "扭曲",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 0
    },
    {
      "key": "rayCount",
      "label": "光束分组",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 32,
      "step": 1,
      "default": 0,
      "help": "0 为连续光谱，否则把光线收束成 N 条"
    },
    { "key": "customColors", "label": "使用自定义颜色", "type": "toggle", "target": "config", "default": false },
    {
      "key": "colors",
      "label": "自定义颜色",
      "type": "colors",
      "target": "config",
      "min": 1,
      "max": 8,
      "default": ["#ff007a", "#4d3dff", "#ffffff"]
    },
    {
      "key": "hoverDampness",
      "label": "鼠标跟随阻尼",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "rays", "name": "十二束", "values": { "rayCount": 12, "animationType": "rotate", "distort": 2 } },
    { "id": "custom", "name": "粉紫自定义", "values": { "customColors": true, "animationType": "hover", "hoverDampness": 0.3 } }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
