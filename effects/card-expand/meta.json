{
  "category": "transition",
  "sub": "shared",
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration",
    "name": "App Store 今日卡片展开"
  },
  "slug": "card-expand",
  "name": "卡片展开转场",
  "tags": ["转场", "共享元素", "View Transitions", "苹果风"],
  "summary": "点击卡片原地长大成详情页大图，返回时严格倒放收回",
  "params": [
    {
      "key": "slides",
      "label": "卡片列表",
      "type": "images",
      "target": "config",
      "min": 2,
      "max": 6,
      "captions": true,
      "default": [
        {
          "src": "/samples/sample-1.webp",
          "caption": "夜枭小憩"
        },
        {
          "src": "/samples/sample-2.webp",
          "caption": "海边老爷车"
        },
        {
          "src": "/samples/sample-3.webp",
          "caption": "日落海滩"
        },
        {
          "src": "/samples/sample-4.webp",
          "caption": "山谷晨光"
        }
      ]
    },
    {
      "key": "duration",
      "label": "转场时长",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 0.8,
      "step": 0.05,
      "default": 0.45,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "ease",
      "label": "缓动曲线",
      "type": "select",
      "target": "css",
      "options": [
        {
          "value": "cubic-bezier(0.2, 0.8, 0.2, 1)",
          "label": "苹果标准（快起缓收）"
        },
        {
          "value": "cubic-bezier(0.32, 0.72, 0, 1)",
          "label": "丝滑收尾"
        },
        {
          "value": "cubic-bezier(0.4, 0, 0.2, 1)",
          "label": "干脆利落"
        }
      ],
      "default": "cubic-bezier(0.2, 0.8, 0.2, 1)"
    },
    {
      "key": "rounded",
      "label": "卡片圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 14,
      "unit": "px",
      "help": "列表卡片与详情大图共用，转场中圆角跟着一起形变"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "apple",
      "name": "苹果原味",
      "values": {
        "duration": 0.5,
        "ease": "cubic-bezier(0.32, 0.72, 0, 1)",
        "rounded": 18
      }
    },
    {
      "id": "crisp",
      "name": "干脆利落",
      "values": {
        "duration": 0.3,
        "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
        "rounded": 8
      }
    }
  ]
}
