{
  "slug": "diagonal-card-flow",
  "name": "斜向叠卡流",
  "category": "showcase",
  "sub": "wall",
  "tags": ["斜向", "叠卡", "3D", "自动播放"],
  "summary": "卡片沿一条斜线一张压一张排成阶梯，越靠下越近越大，整列顺着斜坡缓缓滑下、首尾相接",
  "params": [
    {
      "key": "slides",
      "label": "图片列表",
      "type": "images",
      "target": "config",
      "min": 4,
      "max": 8,
      "captions": false,
      "default": [
        { "src": "/samples/sample-1.webp", "caption": "" },
        { "src": "/samples/sample-2.webp", "caption": "" },
        { "src": "/samples/sample-3.webp", "caption": "" },
        { "src": "/samples/sample-4.webp", "caption": "" },
        { "src": "/samples/sample-5.webp", "caption": "" },
        { "src": "/samples/sample-6.webp", "caption": "" },
        { "src": "/samples/sample-7.webp", "caption": "" },
        { "src": "/samples/sample-8.webp", "caption": "" }
      ]
    },
    {
      "key": "count",
      "label": "同时可见张数",
      "type": "range",
      "target": "config",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 7,
      "help": "斜线上同时排着的卡片数，图片不够时循环取用"
    },
    {
      "key": "angle",
      "label": "斜线角度",
      "type": "range",
      "target": "config",
      "min": 15,
      "max": 60,
      "step": 1,
      "default": 36,
      "unit": "deg",
      "displayUnit": "°",
      "help": "斜线相对水平方向的倾角"
    },
    {
      "key": "spacing",
      "label": "卡片间距",
      "type": "range",
      "target": "config",
      "min": 60,
      "max": 200,
      "step": 5,
      "default": 120,
      "unit": "px",
      "help": "相邻两张沿斜线的距离"
    },
    {
      "key": "cardWidth",
      "label": "卡片宽度",
      "type": "range",
      "target": "css",
      "min": 140,
      "max": 360,
      "step": 10,
      "default": 230,
      "unit": "px"
    },
    {
      "key": "speed",
      "label": "单张走完时长",
      "type": "range",
      "target": "css",
      "min": 8,
      "max": 40,
      "step": 1,
      "default": 18,
      "unit": "s",
      "displayUnit": " 秒",
      "help": "一张卡从左上走到右下所用的时间"
    },
    {
      "key": "scaleEnd",
      "label": "终点放大",
      "type": "range",
      "target": "css",
      "min": 1,
      "max": 1.6,
      "step": 0.05,
      "default": 1.2,
      "help": "走到右下终点时放大到多少倍"
    },
    {
      "key": "reverse",
      "label": "反向（从右下往左上）",
      "type": "toggle",
      "target": "config",
      "default": false
    },
    {
      "key": "radius",
      "label": "卡片圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 14,
      "unit": "px"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "steep", "name": "陡坡密排", "values": { "angle": 55, "spacing": 80, "count": 10 } },
    { "id": "gentle", "name": "缓坡大卡", "values": { "angle": 20, "spacing": 170, "cardWidth": 300, "count": 5 } }
  ],
  "thumb": { "mode": "live" },
  "source": {
    "kind": "visual-inspiration",
    "name": "animos 的 Diagonal Carousel 模板一类效果",
    "url": "https://animos.app",
    "license": "未使用其代码"
  }
}
