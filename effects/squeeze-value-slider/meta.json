{
  "slug": "squeeze-value-slider",
  "name": "挤值圆头滑块",
  "category": "progress",
  "sub": "click",
  "tags": ["进度条", "滑块", "拖拽", "数字翻页", "圆角"],
  "summary": "细滑条拖到右端时把数值挤到自己左侧，进入圆头后逐渐弯成与轨道同心的内圆弧，变化的数字模糊翻页",
  "params": [
    {
      "key": "value",
      "label": "初始进度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 64,
      "displayUnit": "%"
    },
    {
      "key": "width",
      "label": "滑块宽度",
      "type": "range",
      "target": "css",
      "min": 240,
      "max": 600,
      "step": 10,
      "default": 360,
      "unit": "px"
    },
    {
      "key": "height",
      "label": "滑块高度",
      "type": "range",
      "target": "css",
      "min": 36,
      "max": 80,
      "step": 2,
      "default": 56,
      "unit": "px",
      "help": "两端圆头的直径就是它，滑条、数字、间距都按它缩放"
    },
    {
      "key": "gradient",
      "label": "冷暖渐变轨道",
      "type": "toggle",
      "target": "css",
      "default": true,
      "help": "关掉后是纯色轨道，滑条左侧出现填充条"
    },
    {
      "key": "track",
      "label": "轨道色",
      "type": "color",
      "target": "css",
      "default": "#2a2a30",
      "help": "关掉渐变后可见"
    },
    {
      "key": "fill",
      "label": "填充色",
      "type": "color",
      "target": "css",
      "default": "#4a4a52",
      "help": "关掉渐变后滑条左侧的填充条"
    },
    {
      "key": "handle",
      "label": "滑条色",
      "type": "color",
      "target": "css",
      "default": "#241c1c"
    },
    {
      "key": "color",
      "label": "数字色",
      "type": "color",
      "target": "css",
      "default": "#241c1c"
    },
    {
      "key": "unit",
      "label": "单位",
      "type": "text",
      "target": "config",
      "default": "%",
      "maxLength": 4
    },
    {
      "key": "flip",
      "label": "翻页时长",
      "type": "range",
      "target": "css",
      "min": 0.1,
      "max": 0.6,
      "step": 0.02,
      "default": 0.3,
      "unit": "s",
      "displayUnit": " 秒",
      "help": "每一位数字变化时模糊翻页的时长"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "solid",
      "name": "纯色填充",
      "values": { "gradient": false, "handle": "#ffffff", "color": "#ffffff" }
    },
    { "id": "slim", "name": "细长条", "values": { "height": 40, "width": 520, "value": 30 } }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "original" }
}
