{
  "slug": "bubble-menu",
  "name": "气泡菜单",
  "category": "nav",
  "sub": "click",
  "tags": ["菜单", "气泡", "弹出"],
  "summary": "点一下圆按钮，一圈菜单气泡像肥皂泡一样弹出来排开",
  "params": [
    {
      "key": "items",
      "label": "菜单项",
      "type": "text",
      "target": "config",
      "default": "首页｜作品｜关于｜联系｜更多",
      "maxLength": 80,
      "help": "用「｜」分隔"
    },
    {
      "key": "layout",
      "label": "排开方式",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "arc", "label": "扇形环绕按钮" },
        { "value": "row", "label": "横排展开" },
        { "value": "column", "label": "竖排展开" }
      ],
      "default": "arc"
    },
    {
      "key": "distance",
      "label": "弹出距离",
      "type": "range",
      "target": "config",
      "min": 80,
      "max": 240,
      "step": 10,
      "default": 140,
      "unit": "px"
    },
    {
      "key": "stagger",
      "label": "依次弹出间隔",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 150,
      "step": 10,
      "default": 50,
      "displayUnit": " 毫秒"
    },
    {
      "key": "duration",
      "label": "弹出时长",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 1,
      "step": 0.05,
      "default": 0.5,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "bubble",
      "label": "气泡颜色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    { "key": "text", "label": "气泡文字色", "type": "color", "target": "css", "default": "#0a0a0f" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "row",
      "name": "横排快弹",
      "values": { "layout": "row", "distance": 90, "stagger": 30, "duration": 0.3 }
    },
    {
      "id": "far",
      "name": "大扇形慢弹",
      "values": { "distance": 220, "stagger": 100, "duration": 0.8 }
    }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
