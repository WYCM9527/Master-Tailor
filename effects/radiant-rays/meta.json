{
  "slug": "radiant-rays",
  "name": "放射光芒",
  "category": "background",
  "sub": "hover",
  "tags": ["光芒", "体积光", "WebGL", "着色器", "鼠标交互"],
  "summary": "从画面一侧放射开的体积光芒，光束明暗流转，跟着鼠标转向",
  "params": [
    {
      "key": "origin",
      "label": "光源方位",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "top-center", "label": "顶部居中" },
        { "value": "top-left", "label": "左上角" },
        { "value": "top-right", "label": "右上角" },
        { "value": "left", "label": "左侧" },
        { "value": "right", "label": "右侧" },
        { "value": "bottom-center", "label": "底部居中" }
      ],
      "default": "top-center"
    },
    { "key": "color", "label": "光芒颜色", "type": "color", "target": "config", "default": "#ffffff" },
    {
      "key": "speed",
      "label": "流转速度",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "spread",
      "label": "张开角度",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "default": 1,
      "help": "越大光束铺得越开"
    },
    {
      "key": "reach",
      "label": "照射距离",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "default": 2,
      "help": "光能打到多远（相对画面宽度）"
    },
    { "key": "pulsating", "label": "呼吸明暗", "type": "toggle", "target": "config", "default": false },
    {
      "key": "distortion",
      "label": "光束扭曲",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0,
      "help": "光束边缘的波浪扰动"
    },
    {
      "key": "noise",
      "label": "颗粒感",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 0.5,
      "step": 0.05,
      "default": 0.1
    },
    { "key": "followMouse", "label": "跟随鼠标", "type": "toggle", "target": "config", "default": true },
    {
      "key": "mouseInfluence",
      "label": "跟随强度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.1
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "stage", "name": "舞台追光", "values": { "origin": "top-left", "spread": 0.5, "mouseInfluence": 0.3 } },
    {
      "id": "sunset",
      "name": "暖阳",
      "values": { "color": "#ffd9a0", "origin": "right", "pulsating": true, "distortion": 0.3 }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
