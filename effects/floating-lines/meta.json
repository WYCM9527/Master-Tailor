{
  "slug": "floating-lines",
  "name": "浮线背景",
  "category": "background",
  "sub": "hover",
  "tags": ["线条", "辉光", "WebGL", "着色器", "鼠标交互"],
  "summary": "三束发光细线在暗场里旋绕漂浮，鼠标压过去会把线束弯出一个凹陷，还带视差",
  "params": [
    {
      "key": "lineCount",
      "label": "每束线数",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "key": "lineDistance",
      "label": "线间距",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "key": "colors",
      "label": "线色渐变",
      "type": "colors",
      "target": "config",
      "min": 1,
      "max": 8,
      "default": ["#a7ef9e", "#747d67", "#6a6a6a"],
      "help": "一束里的线从第一色渐变到最后一色"
    },
    {
      "key": "waves",
      "label": "线束组合",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "all", "label": "上中下三束" },
        { "value": "middle", "label": "只要中束" },
        { "value": "outer", "label": "上下两束" }
      ],
      "default": "all"
    },
    {
      "key": "speed",
      "label": "漂浮速度",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    { "key": "interactive", "label": "鼠标弯曲", "type": "toggle", "target": "config", "default": true },
    {
      "key": "bendRadius",
      "label": "弯曲范围",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8,
      "help": "越大范围越小（高斯系数）"
    },
    {
      "key": "bendStrength",
      "label": "弯曲力度",
      "type": "range",
      "target": "config",
      "min": -5,
      "max": 5,
      "step": 0.5,
      "default": -2,
      "help": "负值凹陷、正值凸起"
    },
    { "key": "parallax", "label": "鼠标视差", "type": "toggle", "target": "config", "default": true }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "pinkblue", "name": "粉蓝双色", "values": { "colors": ["#e947f5", "#2f4ba2"], "lineCount": 6, "lineDistance": 5 } },
    { "id": "middle", "name": "单束白线", "values": { "waves": "middle", "colors": ["#ffffff", "#5a5a5a"], "bendStrength": -3.5 } }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
