{
  "category": "showcase",
  "sub": "carousel",
  "thumb": {
    "mode": "live"
  },
  "source": {
    "kind": "visual-inspiration",
    "name": "常见 expanding cards / 手风琴图集交互",
    "url": "https://freefrontend.com/css-carousels/",
    "license": "未使用其代码"
  },
  "slug": "accordion-carousel",
  "name": "手风琴轮播",
  "tags": [
    "轮播",
    "展开",
    "悬停"
  ],
  "summary": "几条竖片并排，摸到哪条哪条展开，其余被挤扁",
  "params": [
    {
      "key": "slides",
      "label": "幻灯片",
      "type": "images",
      "target": "config",
      "min": 3,
      "max": 7,
      "captions": true,
      "default": [
        {
          "src": "/samples/sample-1.svg",
          "caption": "琥珀之夜"
        },
        {
          "src": "/samples/sample-2.svg",
          "caption": "海面日出"
        },
        {
          "src": "/samples/sample-3.svg",
          "caption": "山脊星光"
        },
        {
          "src": "/samples/sample-4.svg",
          "caption": "苔原晨雾"
        },
        {
          "src": "/samples/sample-5.svg",
          "caption": "蔷薇暮色"
        }
      ]
    },
    {
      "key": "interval",
      "label": "自动轮流展开间隔",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 3,
      "displayUnit": " 秒",
      "help": "调到 0 表示不自动播放"
    },
    {
      "key": "duration",
      "label": "展开时长",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 1.2,
      "step": 0.05,
      "default": 0.55,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "grow",
      "label": "展开倍率",
      "type": "range",
      "target": "css",
      "min": 2,
      "max": 7,
      "step": 0.5,
      "default": 4,
      "help": "展开条相对收起条的宽度倍数"
    },
    {
      "key": "gap",
      "label": "条间距",
      "type": "range",
      "target": "css",
      "min": 4,
      "max": 20,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#f9cf00"
    },
    {
      "key": "rounded",
      "label": "条圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 14,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "dramatic",
      "name": "大开大合",
      "values": {
        "grow": 6.5,
        "duration": 0.75,
        "gap": 6
      }
    },
    {
      "id": "gentle",
      "name": "轻展慢速",
      "values": {
        "grow": 2.5,
        "interval": 4,
        "duration": 0.9,
        "accent": "#4ade80"
      }
    }
  ]
}
