{
  "slug": "dock-magnify",
  "name": "放大镜停靠栏",
  "category": "nav",
  "sub": "hover",
  "tags": ["停靠栏", "放大", "图标"],
  "summary": "底部一排图标，鼠标靠近哪个哪个鼓起来，邻居跟着微涨",
  "params": [
    {
      "key": "items",
      "label": "图标文字",
      "type": "text",
      "target": "config",
      "default": "首页｜搜索｜收藏｜消息｜设置｜更多",
      "maxLength": 80,
      "help": "用「｜」分隔，每项显示首字作图标"
    },
    {
      "key": "base",
      "label": "图标基础大小",
      "type": "range",
      "target": "config",
      "min": 36,
      "max": 72,
      "step": 2,
      "default": 52,
      "unit": "px"
    },
    {
      "key": "magnify",
      "label": "放大倍数",
      "type": "range",
      "target": "config",
      "min": 1.2,
      "max": 2.4,
      "step": 0.1,
      "default": 1.7
    },
    {
      "key": "radius",
      "label": "影响范围",
      "type": "range",
      "target": "config",
      "min": 60,
      "max": 240,
      "step": 10,
      "default": 140,
      "unit": "px",
      "help": "鼠标左右多远内的图标会跟着涨"
    },
    {
      "key": "lag",
      "label": "回弹迟滞",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 0.3
    },
    {
      "key": "labels",
      "label": "悬停显示名称",
      "type": "toggle",
      "target": "config",
      "default": true
    },
    {
      "key": "accent",
      "label": "图标颜色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    {
      "key": "rounded",
      "label": "图标圆角",
      "type": "range",
      "target": "css",
      "min": 6,
      "max": 30,
      "step": 2,
      "default": 14,
      "unit": "px"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "big",
      "name": "大幅放大",
      "values": { "magnify": 2.3, "radius": 200, "lag": 0.2 }
    },
    {
      "id": "subtle",
      "name": "轻微起伏",
      "values": { "magnify": 1.3, "radius": 90, "lag": 0.6, "labels": false, "rounded": 8 }
    }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
