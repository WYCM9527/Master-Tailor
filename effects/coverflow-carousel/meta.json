{
  "slug": "coverflow-carousel",
  "name": "封面流轮播",
  "category": "showcase",
  "sub": "carousel",
  "tags": ["轮播", "3D", "封面流"],
  "summary": "中央封面正对你，两侧封面倾斜后退，经典 Coverflow",
  "params": [
    {
      "key": "slides",
      "label": "封面列表",
      "type": "images",
      "target": "config",
      "min": 4,
      "max": 8,
      "captions": false,
      "default": [
        { "src": "/samples/sample-1.webp", "caption": "" },
        { "src": "/samples/sample-2.webp", "caption": "" },
        { "src": "/samples/sample-3.webp", "caption": "" },
        { "src": "/samples/sample-4.webp", "caption": "" },
        { "src": "/samples/sample-5.webp", "caption": "" },
        { "src": "/samples/sample-6.webp", "caption": "" }
      ]
    },
    {
      "key": "interval",
      "label": "自动播放间隔",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 4,
      "displayUnit": " 秒",
      "help": "调到 0 表示不自动播放"
    },
    {
      "key": "duration",
      "label": "切换时长",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 1.2,
      "step": 0.05,
      "default": 0.55,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "angle",
      "label": "侧面倾角",
      "type": "range",
      "target": "config",
      "min": 20,
      "max": 70,
      "step": 5,
      "default": 45,
      "unit": "deg",
      "displayUnit": "°"
    },
    {
      "key": "depth",
      "label": "纵深",
      "type": "range",
      "target": "config",
      "min": 60,
      "max": 260,
      "step": 10,
      "default": 150,
      "unit": "px",
      "help": "侧面封面向后退的距离，越大层次越强"
    },
    {
      "key": "gap",
      "label": "封面间距",
      "type": "range",
      "target": "config",
      "min": 20,
      "max": 55,
      "step": 1,
      "default": 34,
      "displayUnit": "%",
      "help": "相邻封面的水平间距，按封面自身宽度的百分比计"
    },
    { "key": "accent", "label": "强调色", "type": "color", "target": "css", "default": "#ffffff" },
    {
      "key": "rounded",
      "label": "封面圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 28,
      "step": 2,
      "default": 14,
      "unit": "px"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "deep", "name": "深邃剧场", "values": { "angle": 62, "depth": 240, "gap": 26, "interval": 5 } },
    { "id": "flat", "name": "轻浮层", "values": { "angle": 28, "depth": 80, "gap": 42, "duration": 0.4, "accent": "#00e5ff" } }
  ],
  "thumb": { "mode": "live" },
  "source": {
    "kind": "visual-inspiration",
    "name": "Apple Cover Flow 与 Swiper coverflow effect",
    "url": "https://swiperjs.com/demos",
    "license": "未使用其代码"
  }
}
