{
  "category": "transition",
  "sub": "push",
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration",
    "name": "iOS 模态弹层（Sheet）"
  },
  "slug": "sheet-present",
  "name": "底部弹层转场",
  "tags": ["转场", "弹层", "iOS", "View Transitions"],
  "summary": "面板从底部升起，背后页面缩小退后，复刻 iOS 模态卡片",
  "params": [
    {
      "key": "duration",
      "label": "转场时长",
      "type": "range",
      "target": "css",
      "min": 0.25,
      "max": 0.7,
      "step": 0.05,
      "default": 0.4,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "sheetH",
      "label": "弹层高度",
      "type": "range",
      "target": "css",
      "min": 45,
      "max": 85,
      "step": 5,
      "default": 65,
      "unit": "%",
      "help": "占容器高度的比例"
    },
    {
      "key": "sheetRadius",
      "label": "弹层顶部圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 28,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "key": "scaleBack",
      "label": "背后页面缩小",
      "type": "range",
      "target": "css",
      "min": 0.86,
      "max": 1,
      "step": 0.01,
      "default": 0.94,
      "unit": "",
      "help": "弹层打开时背后页面缩到这个倍率，1 为不缩"
    },
    {
      "key": "dim",
      "label": "遮罩深浅",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 0.5,
      "step": 0.05,
      "default": 0.25,
      "unit": "",
      "help": "弹层背后遮罩的不透明度"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "tall",
      "name": "高弹层",
      "values": {
        "sheetH": 85,
        "scaleBack": 0.9,
        "dim": 0.35
      }
    },
    {
      "id": "flat",
      "name": "轻遮罩",
      "values": {
        "sheetH": 50,
        "scaleBack": 1,
        "dim": 0.15,
        "duration": 0.3
      }
    }
  ]
}
