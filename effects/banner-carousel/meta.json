{
  "category": "showcase",
  "sub": "carousel",
  "thumb": {
    "mode": "live"
  },
  "source": {
    "kind": "original"
  },
  "slug": "banner-carousel",
  "name": "电商焦点图",
  "tags": [
    "轮播",
    "banner",
    "电商"
  ],
  "summary": "电商首页味道的焦点图：数字分页，悬停才浮现箭头",
  "params": [
    {
      "key": "slides",
      "label": "幻灯片",
      "type": "images",
      "target": "config",
      "min": 3,
      "max": 8,
      "captions": true,
      "default": [
        {
          "src": "/samples/sample-1.webp",
          "caption": "第一帧 · 夜枭小憩"
        },
        {
          "src": "/samples/sample-2.webp",
          "caption": "第二帧 · 海边老爷车"
        },
        {
          "src": "/samples/sample-3.webp",
          "caption": "第三帧 · 日落海滩"
        },
        {
          "src": "/samples/sample-4.webp",
          "caption": "第四帧 · 山谷晨光"
        },
        {
          "src": "/samples/sample-5.webp",
          "caption": "第五帧 · 蓝天夹竹桃"
        }
      ]
    },
    {
      "key": "interval",
      "label": "自动播放间隔",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 3,
      "displayUnit": " 秒",
      "help": "调到 0 表示不自动播放"
    },
    {
      "key": "duration",
      "label": "切换时长",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 1.2,
      "step": 0.05,
      "default": 0.5,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "ratio",
      "label": "容器宽高比",
      "type": "select",
      "target": "css",
      "options": [
        {
          "value": "16 / 9",
          "label": "16:9 宽屏"
        },
        {
          "value": "4 / 3",
          "label": "4:3 标准"
        },
        {
          "value": "3 / 2",
          "label": "3:2 摄影"
        },
        {
          "value": "1 / 1",
          "label": "1:1 方形"
        }
      ],
      "default": "16 / 9"
    },
    {
      "key": "pager",
      "label": "分页器样式",
      "type": "select",
      "target": "config",
      "options": [
        {
          "value": "bullets",
          "label": "圆点"
        },
        {
          "value": "fraction",
          "label": "数字（3 / 5）"
        },
        {
          "value": "progress",
          "label": "进度条"
        },
        {
          "value": "none",
          "label": "不显示"
        }
      ],
      "default": "fraction"
    },
    {
      "key": "arrows",
      "label": "显示左右箭头",
      "type": "toggle",
      "target": "config",
      "default": true
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    {
      "key": "rounded",
      "label": "圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 12,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "taobao",
      "name": "促销节奏",
      "values": {
        "interval": 2.5,
        "duration": 0.35,
        "accent": "#ff4d6d",
        "pager": "bullets"
      }
    },
    {
      "id": "premium",
      "name": "品牌高级感",
      "values": {
        "interval": 5,
        "duration": 0.7,
        "rounded": 20,
        "pager": "progress",
        "arrows": false
      }
    }
  ]
}
