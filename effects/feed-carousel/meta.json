    "轮播",
    "竖向",
    "短视频风"
  ],
  "summary": "手机屏式的竖向内容流，滚轮和上下滑一屏一条",
  "params": [
    {
      "key": "slides",
      "label": "内容列表",
      "type": "images",
      "target": "config",
      "min": 3,
      "max": 8,
      "captions": true,
      "default": [
        {
          "src": "/samples/sample-1.webp",
          "caption": "树枝上打盹的小夜枭，别吵醒它"
        },
        {
          "src": "/samples/sample-2.webp",
          "caption": "海边停着一辆退休的老爷车"
        },
        {
          "src": "/samples/sample-3.webp",
          "caption": "日落时分的海滩，人影都被染成金色"
        },
        {
          "src": "/samples/sample-4.webp",
          "caption": "山谷里的第一道光，值得早起"
        },
        {
          "src": "/samples/sample-5.webp",
          "caption": "蓝天下的夹竹桃，开得毫无保留"
        }
      ]
    },
    {
      "key": "author",
      "label": "作者名",
      "type": "text",
      "target": "config",
      "default": "@裁缝大师",
      "maxLength": 16
    },
    {
      "key": "duration",
      "label": "翻页时长",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 1.2,
      "step": 0.05,
      "default": 0.45,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#f9cf00"
    },
    {
      "key": "rounded",
      "label": "容器圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "snappy",
      "name": "快速刷",
      "values": {
        "duration": 0.3
      }
    },
    {
      "id": "cinematic",
      "name": "慢滑大片",
      "values": {
        "duration": 0.7,
        "accent": "#ff4d6d"
      }
    }
  ]
