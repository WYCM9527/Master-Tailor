{
  "slug": "folder-open",
  "name": "文件夹展开",
  "category": "card",
  "sub": "click",
  "tags": ["文件夹", "纸张", "点击", "拟物"],
  "summary": "一个文件夹图标，悬停时封口斜切张开、纸探出头；点一下三张纸各自飞出旋转摊开",
  "params": [
    { "key": "color", "label": "文件夹颜色", "type": "color", "target": "config", "default": "#27ff64" },
    {
      "key": "size",
      "label": "整体缩放",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 4,
      "step": 0.5,
      "default": 2.5,
      "unit": "×"
    },
    {
      "key": "items",
      "label": "三张纸的文字",
      "type": "text",
      "target": "config",
      "default": "简历｜作品集｜合同",
      "help": "用「｜」分隔，最多三项，留空则是白纸"
    },
    { "key": "autoDemo", "label": "自动开合演示", "type": "toggle", "target": "config", "default": true }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "amber", "name": "牛皮纸夹", "values": { "color": "#e0a24a", "items": "发票｜收据｜账单" } },
    { "id": "blue", "name": "蓝色大夹", "values": { "color": "#4f8cff", "size": 3.5, "items": "｜｜" } }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
