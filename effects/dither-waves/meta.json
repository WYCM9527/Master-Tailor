{
  "slug": "dither-waves",
  "name": "像素抖动波",
  "category": "background",
  "sub": "hover",
  "tags": [
    "像素",
    "抖动",
    "复古",
    "WebGL",
    "鼠标交互"
  ],
  "summary": "复古印刷质感的抖动噪浪缓缓翻滚，鼠标按下去一片凹陷",
  "params": [
    {
      "key": "color",
      "label": "波浪颜色",
      "type": "color",
      "target": "config",
      "default": "#808080"
    },
    {
      "key": "speed",
      "label": "翻滚速度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "default": 0.05
    },
    {
      "key": "frequency",
      "label": "噪浪频率",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 6,
      "step": 0.5,
      "default": 3
    },
    {
      "key": "amplitude",
      "label": "层次强度",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 0.5,
      "step": 0.05,
      "default": 0.3
    },
    {
      "key": "colorNum",
      "label": "色阶数",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "help": "抖动量化的灰阶级数"
    },
    {
      "key": "pixelSize",
      "label": "像素粒度",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 2,
      "unit": "px"
    },
    {
      "key": "mouse",
      "label": "鼠标凹陷",
      "type": "toggle",
      "target": "config",
      "default": true
    },
    {
      "key": "mouseRadius",
      "label": "凹陷半径",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "default": 1
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "newsprint",
      "name": "报纸印刷",
      "values": {
        "colorNum": 2,
        "pixelSize": 3,
        "color": "#b3b3b3"
      }
    },
    {
      "id": "ocean",
      "name": "深海层浪",
      "values": {
        "color": "#4d7799",
        "frequency": 4.5,
        "amplitude": 0.4
      }
    }
  ],
  "thumb": {
    "mode": "live"
  },
  "source": {
    "kind": "visual-inspiration"
  }
}
