{
  "slug": "ball-pit",
  "name": "球池背景",
  "category": "background",
  "sub": "hover",
  "tags": [
    "球",
    "物理",
    "光泽",
    "鼠标交互"
  ],
  "summary": "一池带清漆高光的圆球漂浮互挤、前后遮挡，鼠标是一盏跟着走的灯，也可以是一颗推开它们的球",
  "params": [
    {
      "key": "count",
      "label": "球的数量",
      "type": "range",
      "target": "config",
      "min": 30,
      "max": 300,
      "step": 10,
      "default": 100
    },
    {
      "key": "colors",
      "label": "球色渐变",
      "type": "colors",
      "target": "config",
      "min": 1,
      "max": 5,
      "default": [
        "#ffffff",
        "#000000",
        "#27ff64"
      ],
      "help": "按顺序在球群里做渐变分配"
    },
    {
      "key": "gravity",
      "label": "重力",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 1,
      "step": 0.01,
      "default": 0.01,
      "help": "0 漂浮，1 全部沉到底"
    },
    {
      "key": "friction",
      "label": "摩擦",
      "type": "range",
      "target": "config",
      "min": 0.9,
      "max": 1,
      "step": 0.001,
      "default": 0.9975,
      "help": "越接近 1 越滑"
    },
    {
      "key": "wallBounce",
      "label": "墙面弹性",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 1,
      "step": 0.05,
      "default": 0.95
    },
    {
      "key": "sizeMax",
      "label": "最大球径",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 2,
      "step": 0.1,
      "default": 1,
      "help": "最小球径固定为最大的一半"
    },
    {
      "key": "lightIntensity",
      "label": "灯光强度",
      "type": "range",
      "target": "config",
      "min": 50,
      "max": 500,
      "step": 25,
      "default": 200
    },
    {
      "key": "followCursor",
      "label": "显示光标球",
      "type": "toggle",
      "target": "config",
      "default": false,
      "help": "开启后鼠标位置有一颗实体球推开其他球"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "sink",
      "name": "沉底堆积",
      "values": {
        "gravity": 0.5,
        "count": 200,
        "followCursor": true
      }
    },
    {
      "id": "candy",
      "name": "糖果色",
      "values": {
        "colors": [
          "#5227ff",
          "#ff9ffc",
          "#b19eef"
        ],
        "sizeMax": 1.4
      }
    }
  ],
  "thumb": {
    "mode": "live"
  },
  "source": {
    "kind": "visual-inspiration"
  }
}
