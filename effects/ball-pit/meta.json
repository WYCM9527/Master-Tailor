{
  "slug": "ball-pit",
  "name": "球池背景",
  "category": "background",
  "sub": "hover",
  "tags": ["物理", "球", "互动"],
  "summary": "一池会弹跳、会互相挤的圆球，鼠标像一根搅动它们的棍子",
  "params": [
    {
      "key": "count",
      "label": "球数",
      "type": "range",
      "target": "config",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 45
    },
    {
      "key": "size",
      "label": "球平均直径",
      "type": "range",
      "target": "config",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 56,
      "unit": "px"
    },
    {
      "key": "gravity",
      "label": "重力",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 2000,
      "step": 100,
      "default": 900,
      "help": "0 为失重漂浮"
    },
    {
      "key": "bounce",
      "label": "弹性",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 0.9,
      "step": 0.05,
      "default": 0.5
    },
    {
      "key": "repel",
      "label": "鼠标推力",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "default": 1.2
    },
    {
      "key": "colors",
      "label": "球的颜色",
      "type": "colors",
      "target": "config",
      "min": 1,
      "max": 6,
      "default": ["#ffffff", "#a3a3a3", "#3a3a3a"]
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "zero-g",
      "name": "失重",
      "values": { "gravity": 0, "bounce": 0.9, "count": 30, "size": 80 }
    },
    {
      "id": "beads",
      "name": "小珠子",
      "values": { "count": 120, "size": 24, "gravity": 1600, "bounce": 0.3 }
    }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
