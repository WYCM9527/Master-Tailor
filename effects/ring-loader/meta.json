  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "dots-cyan", "name": "青色点阵", "values": { "style": "dots", "color": "#00e5ff", "speed": 1.4 } },
    { "id": "dual-fast", "name": "疾速双弧", "values": { "style": "dual", "speed": 2, "size": 44, "track": 0.06 } }
