      "type": "range",
      "target": "css",
      "min": 14,
      "max": 36,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    {
      "key": "color",
      "label": "文字颜色",
      "type": "color",
      "target": "css",
      "default": "#aab0c0"
    },
    {
      "key": "hoverColor",
      "label": "悬停高亮色",
