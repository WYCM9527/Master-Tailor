{
  "category": "showcase",
  "sub": "carousel",
  "thumb": {
    "mode": "live"
  },
  "source": {
    "kind": "original"
  },
  "slug": "hero-text-carousel",
  "name": "Hero 图文轮播",
  "tags": [
    "轮播",
    "banner",
    "图文"
  ],
  "summary": "全宽大图轮播，大标题和按钮错峰进场",
  "params": [
    {
      "key": "slides",
      "label": "幻灯片",
      "type": "images",
      "target": "config",
      "min": 3,
      "max": 8,
      "captions": true,
      "default": [
        {
          "src": "/samples/sample-1.webp",
          "caption": "第一帧 · 夜枭小憩"
        },
        {
          "src": "/samples/sample-2.webp",
          "caption": "第二帧 · 海边老爷车"
        },
        {
          "src": "/samples/sample-3.webp",
          "caption": "第三帧 · 日落海滩"
        },
        {
          "src": "/samples/sample-4.webp",
          "caption": "第四帧 · 山谷晨光"
        },
        {
          "src": "/samples/sample-5.webp",
          "caption": "第五帧 · 蓝天夹竹桃"
        }
      ]
    },
    {
      "key": "interval",
      "label": "自动播放间隔",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 5,
      "displayUnit": " 秒",
      "help": "调到 0 表示不自动播放"
    },
    {
      "key": "duration",
      "label": "切换时长",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 1.2,
      "step": 0.05,
      "default": 0.6,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "ctaText",
      "label": "按钮文字",
      "type": "text",
      "target": "config",
      "default": "了解更多",
      "maxLength": 10,
      "help": "留空则不显示按钮"
    },
    {
      "key": "ratio",
      "label": "容器宽高比",
      "type": "select",
      "target": "css",
      "options": [
        {
          "value": "16 / 9",
          "label": "16:9 宽屏"
        },
        {
          "value": "21 / 9",
          "label": "21:9 超宽"
        },
        {
          "value": "4 / 3",
          "label": "4:3 标准"
        },
        {
          "value": "1 / 1",
          "label": "1:1 方形"
        }
      ],
      "default": "21 / 9"
    },
    {
      "key": "pager",
      "label": "分页器样式",
      "type": "select",
      "target": "config",
      "options": [
        {
          "value": "bullets",
          "label": "圆点"
        },
        {
          "value": "fraction",
          "label": "数字（3 / 5）"
        },
        {
          "value": "progress",
          "label": "进度条"
        },
        {
          "value": "none",
          "label": "不显示"
        }
      ],
      "default": "progress"
    },
    {
      "key": "arrows",
      "label": "显示左右箭头",
      "type": "toggle",
      "target": "config",
      "default": true
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    {
      "key": "rounded",
      "label": "圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 16,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "launch",
      "name": "发布会",
      "values": {
        "interval": 6,
        "duration": 0.8,
        "ctaText": "立即预约",
        "accent": "#00e5ff",
        "pager": "bullets"
      }
    },
    {
      "id": "pure",
      "name": "纯图无按钮",
      "values": {
        "ctaText": "",
        "pager": "none",
        "arrows": false,
        "interval": 4
      }
    }
  ]
}
