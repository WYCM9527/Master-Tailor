{
  "slug": "flip-square-loader",
  "name": "方块翻转",
  "category": "loading",
  "sub": "idle",
  "tags": [
    "加载",
    "方块",
    "翻转",
    "3D"
  ],
  "summary": "一个色块交替绕横轴、竖轴翻面，每翻一次颜色变一档，像一枚不停翻转的骰子",
  "params": [
    {
      "key": "colorA",
      "label": "颜色 A",
      "type": "color",
      "target": "css",
      "default": "#7c9cff"
    },
    {
      "key": "colorB",
      "label": "颜色 B",
      "type": "color",
      "target": "css",
      "default": "#f472b6"
    },
    {
      "key": "size",
      "label": "尺寸",
      "type": "range",
      "target": "css",
      "min": 24,
      "max": 120,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "key": "radius",
      "label": "圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8,
      "unit": "px"
    },
    {
      "key": "speed",
      "label": "一轮时长",
      "type": "range",
      "target": "css",
      "min": 0.8,
      "max": 4,
      "step": 0.1,
      "default": 2,
      "unit": "s",
      "displayUnit": " 秒"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "coin",
      "name": "圆币",
      "values": {
        "radius": 24,
        "size": 48,
        "colorA": "#fbbf24",
        "colorB": "#f59e0b"
      }
    },
    {
      "id": "fast",
      "name": "快翻",
      "values": {
        "speed": 1,
        "size": 32
      }
    }
  ],
  "thumb": {
    "mode": "live"
  },
  "source": {
    "kind": "reference",
    "name": "Uiverse 社区常见的方块翻转加载",
    "url": "https://uiverse.io/",
    "license": "MIT（思路参考，代码自写）"
  }
}
