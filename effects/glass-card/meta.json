{
  "slug": "glass-card",
  "name": "玻璃拟态卡片",
  "category": "card",
  "sub": "idle",
  "tags": ["玻璃拟态", "毛玻璃", "悬浮"],
  "summary": "磨砂玻璃卡片悬浮在图片上，背景透出朦胧色彩",
  "params": [
    { "key": "photo", "label": "背景图片", "type": "image", "target": "config", "default": "/samples/sample-2.webp" },
    { "key": "title", "label": "卡片标题", "type": "text", "target": "config", "default": "Glass Card", "maxLength": 20 },
    {
      "key": "blur",
      "label": "磨砂强度",
      "type": "range",
      "target": "css",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 18,
      "unit": "px"
    },
    {
      "key": "whiteness",
      "label": "玻璃白度",
      "type": "range",
      "target": "css",
      "min": 0.02,
      "max": 0.3,
      "step": 0.02,
      "default": 0.1
    },
    {
      "key": "rounded",
      "label": "圆角",
      "type": "range",
      "target": "css",
      "min": 8,
      "max": 36,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    { "key": "float", "label": "悬浮呼吸", "type": "toggle", "target": "css", "default": true, "help": "卡片缓慢上下浮动" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "frosted",
      "name": "重度磨砂",
      "values": { "blur": 34, "whiteness": 0.18, "photo": "/samples/sample-1.webp" }
    },
    {
      "id": "clear",
      "name": "轻透静止",
      "values": { "blur": 8, "whiteness": 0.05, "float": false, "photo": "/samples/sample-3.webp" }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "original" }
}
