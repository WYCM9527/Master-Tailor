{
  "slug": "antigravity-particles",
  "name": "反重力粒子",
  "category": "canvas",
  "sub": "hover",
  "tags": ["粒子", "排斥", "光标"],
  "summary": "满屏细小粒子缓缓上浮，鼠标一到就被推开、绕着走",
  "params": [
    {
      "key": "count",
      "label": "粒子数量",
      "type": "range",
      "target": "config",
      "min": 40,
      "max": 400,
      "step": 20,
      "default": 160
    },
    {
      "key": "drift",
      "label": "上浮速度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 18,
      "displayUnit": " px/秒"
    },
    {
      "key": "radius",
      "label": "排斥半径",
      "type": "range",
      "target": "config",
      "min": 40,
      "max": 300,
      "step": 10,
      "default": 140,
      "unit": "px"
    },
    {
      "key": "force",
      "label": "排斥力度",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1.2
    },
    {
      "key": "size",
      "label": "粒子大小",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "default": 2
    },
    {
      "key": "color",
      "label": "粒子颜色",
      "type": "color",
      "target": "config",
      "default": "#ffffff"
    },
    {
      "key": "connect",
      "label": "近距连线",
      "type": "toggle",
      "target": "config",
      "default": false,
      "help": "相邻粒子之间画细线"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "dust",
      "name": "微尘",
      "values": { "count": 400, "size": 1, "drift": 8, "radius": 90, "force": 0.6 }
    },
    {
      "id": "web",
      "name": "连线星网",
      "values": { "count": 90, "size": 2.5, "connect": true, "radius": 200, "force": 2 }
    }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
