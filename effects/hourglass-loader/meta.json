{
  "slug": "hourglass-loader",
  "name": "沙漏翻转",
  "category": "loading",
  "sub": "idle",
  "tags": [
    "加载",
    "沙漏",
    "翻转",
    "纯 CSS"
  ],
  "summary": "一个由两个三角组成的沙漏：先急转半圈再缓缓停住，停顿一下再转，像真的沙漏被反复翻过来",
  "params": [
    {
      "key": "color",
      "label": "沙漏颜色",
      "type": "color",
      "target": "css",
      "default": "#f2f3f8"
    },
    {
      "key": "size",
      "label": "尺寸",
      "type": "range",
      "target": "css",
      "min": 32,
      "max": 140,
      "step": 4,
      "default": 64,
      "unit": "px"
    },
    {
      "key": "speed",
      "label": "一轮时长",
      "type": "range",
      "target": "css",
      "min": 0.8,
      "max": 4,
      "step": 0.1,
      "default": 1.6,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "turns",
      "label": "每轮转几个半圈",
      "type": "range",
      "target": "css",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "help": "越多越急"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "gold",
      "name": "金沙",
      "values": {
        "color": "#fbbf24",
        "size": 80,
        "turns": 1,
        "speed": 2.2
      }
    },
    {
      "id": "spin",
      "name": "急转",
      "values": {
        "turns": 6,
        "speed": 1.2,
        "color": "#22d3ee"
      }
    }
  ],
  "thumb": {
    "mode": "live"
  },
  "source": {
    "kind": "reference",
    "name": "Uiverse 社区常见的沙漏旋转加载",
    "url": "https://uiverse.io/",
