{
  "slug": "grain-gradient",
  "name": "噪点胶片渐变",
  "category": "background",
  "trigger": "idle",
  "tags": ["渐变", "噪点", "胶片感"],
  "summary": "双色渐变叠加细腻胶片噪点，安静高级的氛围底",
  "params": [
    { "key": "colorA", "label": "起始色", "type": "color", "target": "css", "default": "#1b1035" },
    { "key": "colorB", "label": "结束色", "type": "color", "target": "css", "default": "#0b3441" },
    {
      "key": "angle",
      "label": "渐变角度",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 360,
      "step": 5,
      "default": 135,
      "unit": "deg",
      "displayUnit": "°"
    },
    {
      "key": "grain",
      "label": "噪点浓度",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "default": 0.12
    },
    {
      "key": "breathe",
      "label": "呼吸变化",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "开启后渐变色相极缓慢地流转"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "amber-night",
      "name": "琥珀夜",
      "values": { "colorA": "#2a1c02", "colorB": "#3d0f22", "grain": 0.18, "angle": 160 }
    },
    {
      "id": "mist",
      "name": "青雾",
      "values": { "colorA": "#0e2a2f", "colorB": "#25123d", "grain": 0.08, "breathe": false }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "original" }
}
