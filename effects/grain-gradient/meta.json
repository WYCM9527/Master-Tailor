{
  "slug": "grain-gradient",
  "name": "噪点胶片渐变",
  "category": "background",
  "sub": "idle",
  "tags": ["渐变", "噪点", "胶片感"],
  "summary": "多色渐变叠加细腻胶片噪点，安静高级的氛围底",
  "params": [
    {
      "key": "colors",
      "label": "渐变颜色",
      "type": "colors",
      "target": "config",
      "min": 2,
      "max": 8,
      "default": ["#1b1035", "#0b3441"],
      "help": "按顺序从一端过渡到另一端，颜色越多过渡越丰富"
    },
    {
      "key": "angle",
      "label": "渐变角度",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 360,
      "step": 5,
      "default": 135,
      "unit": "deg",
      "displayUnit": "°"
    },
    {
      "key": "grain",
      "label": "噪点浓度",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 0.3,
      "step": 0.01,
      "default": 0.12
    },
    {
      "key": "breathe",
      "label": "呼吸变化",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "开启后渐变色相极缓慢地流转"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "amber-night",
      "name": "琥珀夜",
      "values": { "colors": ["#2a1c02", "#3d0f22"], "grain": 0.18, "angle": 160 }
    },
    {
      "id": "mist",
      "name": "青雾",
      "values": { "colors": ["#0e2a2f", "#25123d"], "grain": 0.08, "breathe": false }
    },
    {
      "id": "dusk",
      "name": "暮色四段",
      "values": {
        "colors": ["#0b1a3a", "#3a1a4a", "#6b2a3a", "#2a1c02"],
        "angle": 180,
        "grain": 0.14
      }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "original" }
}
