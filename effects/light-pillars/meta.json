{
  "slug": "light-pillars",
  "name": "光柱背景",
  "category": "background",
  "sub": "idle",
  "tags": ["光柱", "舞台", "氛围"],
  "summary": "几道竖直的光柱从上方打下来，缓缓左右摇摆、明暗呼吸",
  "params": [
    {
      "key": "count",
      "label": "光柱数量",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "key": "width",
      "label": "光柱宽度",
      "type": "range",
      "target": "css",
      "min": 40,
      "max": 300,
      "step": 10,
      "default": 120,
      "unit": "px"
    },
    {
      "key": "sway",
      "label": "摇摆幅度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 8,
      "unit": "deg",
      "displayUnit": "°"
    },
    {
      "key": "period",
      "label": "摇摆周期",
      "type": "range",
      "target": "css",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 9,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "blur",
      "label": "边缘柔化",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 24,
      "unit": "px"
    },
    { "key": "color", "label": "光的颜色", "type": "color", "target": "css", "default": "#ffffff" },
    {
      "key": "intensity",
      "label": "亮度",
      "type": "range",
      "target": "css",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "default": 0.5
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "stage",
      "name": "舞台追光",
      "values": { "count": 2, "width": 260, "sway": 16, "period": 6, "intensity": 0.8 }
    },
    {
      "id": "haze",
      "name": "薄雾细柱",
      "values": { "count": 8, "width": 50, "sway": 3, "blur": 50, "intensity": 0.3 }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
