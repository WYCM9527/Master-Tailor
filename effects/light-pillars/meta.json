{
  "slug": "light-pillars",
  "name": "光柱背景",
  "category": "background",
  "sub": "idle",
  "tags": ["光柱", "舞台", "氛围"],
  "summary": "几道柔和的锥形光从上方打下来，缓缓左右摇摆、明暗呼吸",
  "params": [
    {
      "key": "count",
      "label": "光柱数量",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "key": "spread",
      "label": "光柱张角",
      "type": "range",
      "target": "css",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 14,
      "unit": "deg",
      "displayUnit": "°",
      "help": "光从顶点向下散开的角度，越大越像宽幅的舞台光"
    },
    {
      "key": "sway",
      "label": "摇摆幅度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 6,
      "unit": "deg",
      "displayUnit": "°"
    },
    {
      "key": "period",
      "label": "摇摆周期",
      "type": "range",
      "target": "css",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 9,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "blur",
      "label": "边缘柔化",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 60,
      "step": 5,
      "default": 20,
      "unit": "px"
    },
    {
      "key": "reach",
      "label": "照射深度",
      "type": "range",
      "target": "css",
      "min": 40,
      "max": 100,
      "step": 5,
      "default": 70,
      "unit": "%",
      "help": "光在画面多深处衰减到看不见，100 为一直照到底"
    },
    {
      "key": "colors",
      "label": "射灯颜色",
      "type": "colors",
      "target": "config",
      "min": 1,
      "max": 8,
      "default": ["#ffffff", "#4db8ff", "#c04dff"],
      "help": "每道射灯按这个顺序轮流取色，只填一个则全部同色"
    },
    {
      "key": "intensity",
      "label": "亮度",
      "type": "range",
      "target": "css",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 0.75
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "stage",
      "name": "舞台追光",
      "values": {
        "count": 2,
        "spread": 26,
        "sway": 14,
        "period": 6,
        "intensity": 0.9,
        "reach": 100
      }
    },
    {
      "id": "haze",
      "name": "薄雾细柱",
      "values": { "count": 8, "spread": 6, "sway": 3, "blur": 40, "intensity": 0.35, "reach": 60 }
    },
    {
      "id": "concert",
      "name": "彩色舞台",
      "values": {
        "count": 5,
        "spread": 18,
        "sway": 10,
        "period": 5,
        "intensity": 0.9,
        "reach": 100,
        "colors": ["#ff4d6d", "#ffd166", "#4dff88", "#4db8ff", "#c04dff"]
      }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
