{
  "slug": "scroll-velocity-marquee",
  "name": "滚速跑马灯",
  "category": "text",
  "sub": "marquee",
  "tags": [
    "跑马灯",
    "滚动",
    "速度"
  ],
  "summary": "两排大字随页面滚动的快慢加速、减速甚至倒流",
  "params": [
    {
      "key": "textA",
      "label": "第一排文案",
      "type": "text",
      "target": "config",
      "default": "SCROLL FASTER · 滚得越快跑得越快 · ",
      "maxLength": 60
    },
    {
      "key": "textB",
      "label": "第二排文案",
      "type": "text",
      "target": "config",
      "default": "反向那一排 · THE OTHER WAY · ",
      "maxLength": 60
    },
    {
      "key": "baseSpeed",
      "label": "基础速度",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 60,
      "displayUnit": " px/秒",
      "help": "不滚动时的匀速，0 为静止只随滚动而动"
    },
    {
      "key": "gain",
      "label": "滚动增益",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 8,
      "step": 0.5,
      "default": 3,
      "help": "页面滚动速度对跑马灯速度的放大倍数，越大越敏感"
    },
    {
      "key": "skew",
      "label": "随速倾斜",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "跑得快时文字顺势倾斜一点"
    },
    {
      "key": "hollow",
      "label": "第二排空心字",
      "type": "toggle",
      "target": "config",
      "default": false
    },
    {
      "key": "color",
      "label": "文字颜色",
      "type": "color",
      "target": "css",
      "default": "#f2f3f8"
    },
    {
      "key": "fontSize",
      "label": "字号",
      "type": "range",
      "target": "css",
      "min": 32,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    {
      "key": "font",
      "label": "字体",
      "type": "font",
      "target": "css",
      "default": "smiley-sans"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "still",
      "name": "只随滚动",
      "values": {
        "baseSpeed": 0,
        "gain": 6,
        "skew": false
      }
    },
    {
      "id": "outline",
      "name": "巨字慢滚",
      "values": {
        "fontSize": 112,
        "baseSpeed": 30,
        "gain": 2,
        "font": "system-sans"
      }
    }
  ],
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration"
  }
}
