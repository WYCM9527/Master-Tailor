{
  "slug": "image-trail",
  "name": "图片拖尾",
  "category": "canvas",
  "sub": "hover",
  "tags": [
    "光标",
    "图片",
    "拖尾"
  ],
  "summary": "鼠标划过的地方一张张图片依次冒出，每张从滞后一点的位置滑向鼠标、停一下再缩小消失，连成一条有方向感的图片尾迹",
  "params": [
    {
      "key": "slides",
      "label": "轮流出现的图片",
      "type": "images",
      "target": "config",
      "min": 2,
      "max": 8,
      "captions": false,
      "default": [
        {
          "src": "/samples/sample-1.webp",
          "caption": ""
        },
        {
          "src": "/samples/sample-2.webp",
          "caption": ""
        },
        {
          "src": "/samples/sample-3.webp",
          "caption": ""
        },
        {
          "src": "/samples/sample-4.webp",
          "caption": ""
        },
        {
          "src": "/samples/sample-5.webp",
          "caption": ""
        }
      ]
    },
    {
      "key": "spacing",
      "label": "出现间距",
      "type": "range",
      "target": "config",
      "min": 30,
      "max": 200,
      "step": 10,
      "default": 80,
      "unit": "px",
      "help": "鼠标每移动多远冒出一张"
    },
    {
      "key": "size",
      "label": "图片宽度",
      "type": "range",
      "target": "css",
      "min": 80,
      "max": 320,
      "step": 10,
      "default": 180,
      "unit": "px"
    },
    {
      "key": "lifetime",
      "label": "停留时间",
      "type": "range",
      "target": "css",
      "min": 0.4,
      "max": 3,
      "step": 0.1,
      "default": 1.2,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "maxCount",
      "label": "最多同屏",
      "type": "range",
      "target": "config",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "key": "tilt",
      "label": "随机倾斜",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 30,
      "step": 5,
      "default": 12,
      "unit": "deg",
      "displayUnit": "°"
    },
    {
      "key": "rounded",
      "label": "图片圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 24,
      "step": 2,
      "default": 8,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "dense",
      "name": "密集小图",
      "values": {
        "spacing": 40,
        "size": 100,
        "lifetime": 0.8,
        "maxCount": 16,
        "tilt": 25
      }
    },
    {
      "id": "posters",
      "name": "大海报慢留",
      "values": {
        "spacing": 160,
        "size": 280,
        "lifetime": 2.4,
        "maxCount": 5,
        "tilt": 0,
        "rounded": 2
      }
    }
  ],
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration"
  }
}
