{
  "slug": "decrypt-reveal-text",
  "name": "解密显形文字",
  "category": "text",
  "sub": "idle",
  "tags": ["解密", "乱码", "黑客"],
  "summary": "一串乱码逐位「解出」真实文字，像密文被破译",
  "params": [
    {
      "key": "text",
      "label": "文案",
      "type": "text",
      "target": "config",
      "default": "ACCESS GRANTED · 欢迎回来",
      "maxLength": 50
    },
    {
      "key": "order",
      "label": "解出顺序",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "ltr", "label": "从左到右" },
        { "value": "center", "label": "从中间向两边" },
        { "value": "random", "label": "随机位置" }
      ],
      "default": "ltr"
    },
    {
      "key": "speed",
      "label": "解出速度",
      "type": "range",
      "target": "config",
      "min": 10,
      "max": 120,
      "step": 5,
      "default": 45,
      "displayUnit": " 毫秒/位"
    },
    {
      "key": "flicker",
      "label": "乱码刷新",
      "type": "range",
      "target": "config",
      "min": 20,
      "max": 150,
      "step": 10,
      "default": 50,
      "displayUnit": " 毫秒",
      "help": "未解出的位每隔多久换一个乱字"
    },
    {
      "key": "glyphs",
      "label": "乱码字符",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "mixed", "label": "字母数字符号" },
        { "value": "binary", "label": "0 和 1" },
        { "value": "kana", "label": "假名与方块" }
      ],
      "default": "mixed"
    },
    { "key": "color", "label": "文字颜色", "type": "color", "target": "css", "default": "#f2f3f8" },
    {
      "key": "cipher",
      "label": "乱码颜色",
      "type": "color",
      "target": "css",
      "default": "#6b6b6b"
    },
    {
      "key": "fontSize",
      "label": "字号",
      "type": "range",
      "target": "css",
      "min": 20,
      "max": 72,
      "step": 2,
      "default": 36,
      "unit": "px"
    },
    { "key": "font", "label": "字体", "type": "font", "target": "css", "default": "jetbrains-mono" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "matrix",
      "name": "黑客绿",
      "values": {
        "color": "#4ade80",
        "cipher": "#1f5a34",
        "glyphs": "kana",
        "order": "random",
        "speed": 30
      }
    },
    {
      "id": "binary",
      "name": "二进制",
      "values": { "glyphs": "binary", "order": "center", "speed": 60, "flicker": 30 }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
