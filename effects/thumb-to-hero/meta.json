{
  "category": "transition",
  "sub": "shared",
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration",
    "name": "iOS 照片 App 缩略图展开"
  },
  "slug": "thumb-to-hero",
  "name": "缩略图长成头图",
  "tags": ["转场", "共享元素", "图库", "View Transitions"],
  "summary": "小方缩略图跨页长成宽幅头图，比例变化全程裁切不变形",
  "params": [
    {
      "key": "slides",
      "label": "图库图片",
      "type": "images",
      "target": "config",
      "min": 3,
      "max": 8,
      "captions": true,
      "default": [
        {
          "src": "/samples/sample-1.webp",
          "caption": "夜枭小憩"
        },
        {
          "src": "/samples/sample-5.webp",
          "caption": "蓝天夹竹桃"
        },
        {
          "src": "/samples/sample-3.webp",
          "caption": "日落海滩"
        },
        {
          "src": "/samples/sample-4.webp",
          "caption": "山谷晨光"
        },
        {
          "src": "/samples/sample-8.webp",
          "caption": "城市夜色"
        },
        {
          "src": "/samples/sample-2.webp",
          "caption": "海边老爷车"
        }
      ]
    },
    {
      "key": "duration",
      "label": "转场时长",
      "type": "range",
      "target": "css",
      "min": 0.25,
      "max": 0.8,
      "step": 0.05,
      "default": 0.5,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "ease",
      "label": "缓动曲线",
      "type": "select",
      "target": "css",
      "options": [
        {
          "value": "cubic-bezier(0.32, 0.72, 0, 1)",
          "label": "丝滑收尾"
        },
        {
          "value": "cubic-bezier(0.2, 0.8, 0.2, 1)",
          "label": "苹果标准（快起缓收）"
        },
        {
          "value": "cubic-bezier(0.4, 0, 0.2, 1)",
          "label": "干脆利落"
        }
      ],
      "default": "cubic-bezier(0.32, 0.72, 0, 1)"
    },
    {
      "key": "rounded",
      "label": "缩略图圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 20,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "gallery",
      "name": "画廊慢展",
      "values": {
        "duration": 0.7,
        "rounded": 4
      }
    },
    {
      "id": "snap",
      "name": "快翻",
      "values": {
        "duration": 0.3,
        "ease": "cubic-bezier(0.4, 0, 0.2, 1)"
      }
    }
  ]
}
