{
  "slug": "pill-nav",
  "name": "胶囊导航",
  "category": "nav",
  "sub": "hover",
  "tags": ["导航", "胶囊", "填充"],
  "summary": "一排胶囊按钮，悬停时一团圆形底色从下方涨满整颗胶囊",
  "params": [
    {
      "key": "items",
      "label": "菜单项",
      "type": "text",
      "target": "config",
      "default": "作品｜关于｜服务｜日志｜联系",
      "maxLength": 80,
      "help": "用「｜」分隔"
    },
    {
      "key": "activeIndex",
      "label": "默认选中第几项",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    { "key": "pill", "label": "胶囊底色", "type": "color", "target": "css", "default": "#ffffff" },
    {
      "key": "fill",
      "label": "涨起的颜色",
      "type": "color",
      "target": "css",
      "default": "#0a0a0f"
    },
    { "key": "text", "label": "文字颜色", "type": "color", "target": "css", "default": "#0a0a0f" },
    {
      "key": "textHover",
      "label": "悬停文字颜色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    {
      "key": "duration",
      "label": "涨起时长",
      "type": "range",
      "target": "css",
      "min": 0.15,
      "max": 0.8,
      "step": 0.05,
      "default": 0.35,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "logo",
      "label": "左侧圆徽标",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "导航左端放一个会转的圆形徽标"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "inverse",
      "name": "黑胶囊白涨",
      "values": { "pill": "#1c1c1c", "fill": "#ffffff", "text": "#ffffff", "textHover": "#0a0a0f" }
    },
    {
      "id": "slow",
      "name": "慢涨无徽标",
      "values": { "duration": 0.7, "logo": false, "activeIndex": 3 }
    }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
