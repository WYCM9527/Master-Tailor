{
  "slug": "text-pressure",
  "name": "文字压力",
  "category": "text",
  "sub": "hover",
  "tags": ["文字", "字重", "鼠标跟随", "变形"],
  "summary": "一行撑满宽度的大字，鼠标靠近哪个字，它就被「压」得又粗又宽又斜，远处的字细瘦端正，像手指按在软字上",
  "params": [
    { "key": "text", "label": "文字", "type": "text", "target": "config", "default": "PRESSURE", "maxLength": 14 },
    { "key": "width", "label": "变宽", "type": "toggle", "target": "config", "default": true },
    { "key": "weight", "label": "变粗", "type": "toggle", "target": "config", "default": true },
    { "key": "italic", "label": "变斜", "type": "toggle", "target": "config", "default": true },
    { "key": "alpha", "label": "远处变淡", "type": "toggle", "target": "config", "default": false },
    { "key": "stroke", "label": "描边模式", "type": "toggle", "target": "config", "default": false, "help": "开启后只显示描边，颜色用描边色" },
    { "key": "textColor", "label": "文字颜色", "type": "color", "target": "css", "default": "#ffffff" },
    { "key": "strokeColor", "label": "描边颜色", "type": "color", "target": "css", "default": "#00ff00" },
    {
      "key": "font",
      "label": "字体",
      "type": "font",
      "target": "css",
      "default": "system-sans"
    },
    {
      "key": "minFontSize",
      "label": "最小字号",
      "type": "range",
      "target": "config",
      "min": 24,
      "max": 120,
      "step": 4,
      "default": 24,
      "unit": "px"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "outline", "name": "绿描边", "values": { "stroke": true, "italic": false } },
    { "id": "cn", "name": "中文黑体", "values": { "text": "按压这行字", "font": "noto-sans-sc", "italic": false, "alpha": true } }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
