{
  "slug": "metaballs-blob",
  "name": "融球",
  "category": "canvas",
  "sub": "idle",
  "tags": ["融球", "液态", "有机"],
  "summary": "几团圆球慢慢游动，靠近时像水银一样黏合成一块",
  "params": [
    {
      "key": "count",
      "label": "球体数量",
      "type": "range",
      "target": "config",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "key": "size",
      "label": "球体大小",
      "type": "range",
      "target": "config",
      "min": 40,
      "max": 200,
      "step": 10,
      "default": 110,
      "unit": "px",
      "help": "平均直径，每颗在此基础上随机大小"
    },
    {
      "key": "speed",
      "label": "游动速度",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1
    },
    {
      "key": "goo",
      "label": "黏合强度",
      "type": "range",
      "target": "config",
      "min": 6,
      "max": 40,
      "step": 2,
      "default": 20,
      "help": "球体靠近时融合的范围"
    },
    {
      "key": "follow",
      "label": "一颗跟随鼠标",
      "type": "toggle",
      "target": "config",
      "default": true
    },
    { "key": "color", "label": "球体颜色", "type": "color", "target": "css", "default": "#ffffff" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "mercury",
      "name": "水银一大团",
      "values": { "count": 10, "size": 150, "goo": 36, "speed": 0.6 }
    },
    {
      "id": "beads",
      "name": "小珠子快游",
      "values": { "count": 12, "size": 50, "goo": 10, "speed": 2.4, "follow": false }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
