{
  "slug": "focus-frame-words",
  "name": "焦点框逐词聚焦",
  "category": "text",
  "sub": "idle",
  "tags": ["聚焦", "取景框", "模糊"],
  "summary": "一枚取景框在词语间跳动，框住的词清晰，其余虚化",
  "params": [
    {
      "key": "text",
      "label": "文案",
      "type": "text",
      "target": "config",
      "default": "专注 当下 这一个 词",
      "maxLength": 60,
      "help": "按空格分词，取景框逐词跳动"
    },
    {
      "key": "interval",
      "label": "每词停留",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 4,
      "step": 0.25,
      "default": 1.2,
      "displayUnit": " 秒"
    },
    {
      "key": "moveDuration",
      "label": "跳动时长",
      "type": "range",
      "target": "css",
      "min": 0.15,
      "max": 1,
      "step": 0.05,
      "default": 0.4,
      "unit": "s",
      "displayUnit": " 秒",
      "help": "取景框从一个词滑到下一个词的时间"
    },
    {
      "key": "blurAmount",
      "label": "虚化程度",
      "type": "range",
      "target": "css",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 5,
      "unit": "px"
    },
    {
      "key": "hover",
      "label": "鼠标指哪聚哪",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "鼠标停在某个词上时取景框跟过去并暂停自动跳动"
    },
    {
      "key": "frame",
      "label": "取景框颜色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    { "key": "color", "label": "文字颜色", "type": "color", "target": "css", "default": "#f2f3f8" },
    {
      "key": "fontSize",
      "label": "字号",
      "type": "range",
      "target": "css",
      "min": 24,
      "max": 80,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    { "key": "font", "label": "字体", "type": "font", "target": "css", "default": "system-sans" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "snappy",
      "name": "快速扫读",
      "values": { "interval": 0.6, "moveDuration": 0.2, "blurAmount": 3 }
    },
    {
      "id": "dreamy",
      "name": "重虚化慢移",
      "values": {
        "interval": 2.5,
        "moveDuration": 0.8,
        "blurAmount": 10,
        "frame": "#a3a3a3",
        "font": "lxgw-wenkai"
      }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
