{
  "slug": "pixel-trail",
  "name": "像素拖尾",
  "category": "canvas",
  "sub": "hover",
  "tags": [
    "像素",
    "网格",
    "光标"
  ],
  "summary": "鼠标划过处一团柔和的光斑被量化成一格格像素亮起，划得越快越亮，随后逐格熄灭，快速甩动也不断开",
  "params": [
    {
      "key": "cell",
      "label": "格子大小",
      "type": "range",
      "target": "config",
      "min": 8,
      "max": 60,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "key": "fade",
      "label": "光斑寿命",
      "type": "range",
      "target": "config",
      "min": 150,
      "max": 2000,
      "step": 50,
      "default": 500,
      "displayUnit": " 毫秒"
    },
    {
      "key": "spread",
      "label": "光斑半径",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2,
      "displayUnit": " 格",
      "help": "鼠标所在格周围几格一起亮，0 只亮所在格"
    },
    {
      "key": "gap",
      "label": "格间缝",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 2,
      "unit": "px"
    },
    {
      "key": "color",
      "label": "亮起颜色",
      "type": "color",
      "target": "config",
      "default": "#ffffff"
    },
    {
      "key": "grid",
      "label": "显示底格",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "未亮的格子画一层极淡的底色"
    },
    {
      "key": "rounded",
      "label": "圆角格",
      "type": "toggle",
      "target": "config",
      "default": false
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "fine",
      "name": "细像素长尾",
      "values": {
        "cell": 12,
        "fade": 2000,
        "spread": 1,
        "gap": 1
      }
    },
    {
      "id": "blocks",
      "name": "大格圆角",
      "values": {
        "cell": 52,
        "fade": 600,
        "spread": 1,
        "gap": 6,
        "rounded": true,
        "grid": false
      }
    }
  ],
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration"
  }
}
