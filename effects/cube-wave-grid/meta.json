{
  "slug": "cube-wave-grid",
  "name": "方块波纹网格",
  "category": "background",
  "sub": "hover",
  "tags": ["网格", "3D", "立方体", "涟漪"],
  "summary": "一片白描边的立体方块随鼠标成片倾斜，点一下涟漪般逐环闪白",
  "params": [
    {
      "key": "gridSize",
      "label": "网格规模",
      "type": "range",
      "target": "config",
      "min": 5,
      "max": 16,
      "step": 1,
      "default": 10,
      "help": "每行每列的方块数"
    },
    {
      "key": "maxAngle",
      "label": "最大倾角",
      "type": "range",
      "target": "config",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 45,
      "unit": "°"
    },
    {
      "key": "radius",
      "label": "影响半径",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 6,
      "step": 0.5,
      "default": 3,
      "displayUnit": " 格"
    },
    { "key": "faceColor", "label": "方块面色", "type": "color", "target": "css", "default": "#0b0b0b" },
    { "key": "borderColor", "label": "描边颜色", "type": "color", "target": "css", "default": "#ffffff" },
    { "key": "rippleOnClick", "label": "点击涟漪", "type": "toggle", "target": "config", "default": true },
    { "key": "rippleColor", "label": "涟漪闪色", "type": "color", "target": "css", "default": "#ffffff" },
    {
      "key": "rippleSpeed",
      "label": "涟漪速度",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "default": 2
    },
    { "key": "autoAnimate", "label": "无鼠标时自动游走", "type": "toggle", "target": "config", "default": true }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "dense", "name": "密网轻倾", "values": { "gridSize": 16, "maxAngle": 25, "radius": 4 } },
    {
      "id": "neon",
      "name": "青光方阵",
      "values": { "borderColor": "#3ddcff", "rippleColor": "#3ddcff", "faceColor": "#04121a", "maxAngle": 60 }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
