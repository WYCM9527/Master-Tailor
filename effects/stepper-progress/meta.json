{
  "slug": "stepper-progress",
  "name": "步骤进度条",
  "category": "progress",
  "sub": "button",
  "tags": ["步骤条", "结账流程", "对勾", "连线", "呼吸", "分步表单"],
  "summary": "结账流程式的节点条：连线逐段灌满，完成的节点变成对勾，当前节点外圈呼吸，内容顺着方向滑入",
  "params": [
    {
      "key": "steps",
      "label": "步骤",
      "type": "text",
      "target": "config",
      "default": "购物车｜收货地址｜支付｜完成",
      "maxLength": 40,
      "help": "用「｜」分隔，2 到 6 步"
    },
    {
      "key": "current",
      "label": "当前步",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2,
      "help": "打开时停在第几步"
    },
    {
      "key": "duration",
      "label": "连线时长",
      "type": "range",
      "target": "config",
      "min": 0.2,
      "max": 1.5,
      "step": 0.05,
      "default": 0.5,
      "displayUnit": " 秒",
      "help": "连线灌满一段要多久"
    },
    {
      "key": "pulse",
      "label": "呼吸光圈",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "当前节点外圈一直轻轻扩散"
    },
    {
      "key": "panel",
      "label": "内容面板",
      "type": "toggle",
      "target": "config",
      "default": true,
      "help": "节点条下方显示当前步的内容卡片"
    },
    {
      "key": "color",
      "label": "主色",
      "type": "color",
      "target": "css",
      "default": "#4f46e5"
    },
    {
      "key": "nodeSize",
      "label": "节点大小",
      "type": "range",
      "target": "css",
      "min": 24,
      "max": 44,
      "step": 2,
      "default": 32,
      "unit": "px"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "short",
      "name": "三步",
      "values": { "steps": "填写信息｜确认订单｜完成", "current": 1 }
    },
    { "id": "slow", "name": "慢灌", "values": { "duration": 1.2 } },
    { "id": "mint", "name": "薄荷", "values": { "color": "#10b981" } }
  ],
  "thumb": { "mode": "autoplay" },
  "source": {
    "kind": "reference",
    "name": "SmoothUI · Animated Stepper",
    "url": "https://smoothui.dev/docs/components/animated-stepper",
    "license": "MIT（思路参考，代码自写）"
  }
}
