{
  "slug": "grid-scan-lines",
  "name": "扫描线网格",
  "category": "background",
  "sub": "hover",
  "tags": ["网格", "隧道", "扫描", "WebGL", "科技感"],
  "summary": "一条四壁都是网格的透视隧道，一道绿光沿深度往返扫描，鼠标一动整条隧道跟着转视角",
  "params": [
    { "key": "linesColor", "label": "网格线颜色", "type": "color", "target": "config", "default": "#2c3d32" },
    { "key": "scanColor", "label": "扫描光颜色", "type": "color", "target": "config", "default": "#48ff28" },
    {
      "key": "gridScale",
      "label": "网格密度",
      "type": "range",
      "target": "config",
      "min": 0.04,
      "max": 0.3,
      "step": 0.01,
      "default": 0.1,
      "help": "越小格子越密"
    },
    {
      "key": "lineThickness",
      "label": "线粗",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 4,
      "step": 0.5,
      "default": 1,
      "unit": "px"
    },
    {
      "key": "lineStyle",
      "label": "线型",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "solid", "label": "实线" },
        { "value": "dashed", "label": "虚线" },
        { "value": "dotted", "label": "点线" }
      ],
      "default": "solid"
    },
    {
      "key": "lineJitter",
      "label": "线条抖动",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.1
    },
    {
      "key": "scanDirection",
      "label": "扫描方向",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "pingpong", "label": "往返" },
        { "value": "forward", "label": "由近及远" },
        { "value": "backward", "label": "由远及近" }
      ],
      "default": "pingpong"
    },
    {
      "key": "scanOpacity",
      "label": "扫描亮度",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 0.4
    },
    {
      "key": "scanGlow",
      "label": "扫描带宽度",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 2,
      "step": 0.1,
      "default": 0.5
    },
    {
      "key": "noise",
      "label": "噪点",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 0.1,
      "step": 0.005,
      "default": 0.01
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "cyan", "name": "青色虚线", "values": { "linesColor": "#1f3a44", "scanColor": "#3ddcff", "lineStyle": "dashed", "scanGlow": 0.8 } },
    { "id": "dense", "name": "密网快扫", "values": { "gridScale": 0.06, "lineJitter": 0.3, "scanDirection": "forward", "scanOpacity": 0.7 } }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
