{
  "slug": "dot-grid-spotlight",
  "name": "点阵网格聚光",
  "category": "background",
  "sub": "hover",
  "tags": ["网格", "点阵", "惯性", "鼠标交互"],
  "summary": "均匀点阵，鼠标靠近的点亮起；快速划过时点被甩开再弹性弹回，点一下炸开一圈冲击波",
  "params": [
    {
      "key": "dotSize",
      "label": "点的直径",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 5,
      "unit": "px"
    },
    {
      "key": "gap",
      "label": "点间距",
      "type": "range",
      "target": "config",
      "min": 5,
      "max": 50,
      "step": 1,
      "default": 15,
      "unit": "px"
    },
    { "key": "baseColor", "label": "点的底色", "type": "color", "target": "config", "default": "#333333" },
    { "key": "activeColor", "label": "靓亮颜色", "type": "color", "target": "config", "default": "#27ff64" },
    {
      "key": "proximity",
      "label": "感应半径",
      "type": "range",
      "target": "config",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120,
      "unit": "px"
    },
    {
      "key": "shockRadius",
      "label": "冲击波半径",
      "type": "range",
      "target": "config",
      "min": 100,
      "max": 500,
      "step": 10,
      "default": 250,
      "unit": "px"
    },
    {
      "key": "shockStrength",
      "label": "冲击力度",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 15,
      "step": 0.5,
      "default": 5
    },
    {
      "key": "resistance",
      "label": "滑行阻力",
      "type": "range",
      "target": "config",
      "min": 100,
      "max": 2000,
      "step": 50,
      "default": 750,
      "help": "越大被甩开的点停得越快"
    },
    {
      "key": "returnDuration",
      "label": "弹回时长",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 3,
      "step": 0.1,
      "default": 1.5,
      "unit": "s"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "big", "name": "大点大爆", "values": { "dotSize": 12, "gap": 28, "shockStrength": 9, "activeColor": "#ffffff" } },
    { "id": "violet", "name": "紫光细网", "values": { "dotSize": 3, "gap": 12, "activeColor": "#a48bff", "proximity": 180 } }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
