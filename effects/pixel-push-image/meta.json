{
  "slug": "pixel-push-image",
  "name": "像素扭曲图",
  "category": "canvas",
  "sub": "hover",
  "tags": ["像素化", "图片", "推开", "弹簧"],
  "summary": "图片被拆成一格格色块，鼠标划过哪里，那里的色块就被推开、让出一个洞，鼠标走后它们再弹回原位",
  "params": [
    { "key": "photo", "label": "图片", "type": "image", "target": "config", "default": "/samples/sample-6.webp" },
    { "key": "cell", "label": "像素块大小", "type": "range", "target": "config", "min": 4, "max": 24, "step": 1, "default": 8, "unit": "px" },
    { "key": "radius", "label": "影响半径", "type": "range", "target": "config", "min": 40, "max": 300, "step": 10, "default": 120, "unit": "px" },
    { "key": "strength", "label": "推开距离", "type": "range", "target": "config", "min": 5, "max": 120, "step": 5, "default": 40, "unit": "px" },
    { "key": "spring", "label": "回弹速度", "type": "range", "target": "config", "min": 0.03, "max": 0.4, "step": 0.01, "default": 0.12 },
    { "key": "shape", "label": "像素形状", "type": "select", "target": "config", "options": [{ "value": "square", "label": "方块" }, { "value": "circle", "label": "圆点" }], "default": "square" },
    { "key": "gap", "label": "块间缝", "type": "range", "target": "config", "min": 0, "max": 6, "step": 1, "default": 1, "unit": "px" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "dots", "name": "圆点网", "values": { "shape": "circle", "cell": 12, "gap": 3, "radius": 160 } },
    { "id": "fine", "name": "细密大推", "values": { "cell": 5, "gap": 0, "strength": 90, "spring": 0.06, "photo": "/samples/sample-7.webp" } }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration", "name": "Aceternity UI 的 Pixelated Canvas（Tailwind 官网同款）一类像素扭曲", "url": "https://ui.aceternity.com", "license": "未使用其代码" }
}
