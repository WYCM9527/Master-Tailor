{
  "slug": "jelly-blob-cursor",
  "name": "果冻光标",
  "category": "canvas",
  "sub": "hover",
  "tags": [
    "光标",
    "果冻",
    "融合"
  ],
  "summary": "几颗半透明的果冻球带着白色高光点和投影黏在一起跟着鼠标跑，越靠后越慢，拉出黏稠的拖尾",
  "params": [
    {
      "key": "count",
      "label": "球体数量",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "key": "size",
      "label": "最大球直径",
      "type": "range",
      "target": "css",
      "min": 20,
      "max": 200,
      "step": 5,
      "default": 125,
      "unit": "px"
    },
    {
      "key": "lag",
      "label": "跟随迟滞",
      "type": "range",
      "target": "config",
      "min": 0.05,
      "max": 0.5,
      "step": 0.05,
      "default": 0.18,
      "help": "越小拖得越远、越黏"
    },
    {
      "key": "goo",
      "label": "黏合强度",
      "type": "range",
      "target": "config",
      "min": 4,
      "max": 24,
      "step": 2,
      "default": 12,
      "help": "球体靠近时边缘融合的程度"
    },
    {
      "key": "color",
      "label": "球体颜色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    {
      "key": "hideCursor",
      "label": "隐藏系统光标",
      "type": "toggle",
      "target": "config",
      "default": true
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "single",
      "name": "单球紧随",
      "values": {
        "count": 1,
        "size": 36,
        "lag": 0.4,
        "goo": 4
      }
    },
    {
      "id": "slime",
      "name": "拖长黏液",
      "values": {
        "count": 5,
        "size": 80,
        "lag": 0.08,
        "goo": 20
      }
    }
  ],
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration"
  }
}
