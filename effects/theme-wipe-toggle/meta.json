      { "value": "square", "label": "方形" },
      { "value": "star", "label": "五角星" }
    ], "default": "circle" },
    { "key": "fromCenter", "label": "从屏幕中心扩散", "type": "toggle", "target": "config", "default": false, "help": "关闭则从按钮位置扩散" },
