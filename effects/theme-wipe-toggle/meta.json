    { "key": "title", "label": "标题", "type": "text", "target": "config", "default": "白天与夜晚，一键切换", "maxLength": 24 },
    { "key": "desc", "label": "说明", "type": "text", "target": "config", "default": "点右上角的按钮：新主题不是闪一下换掉，而是从按钮那一点向整个页面扩散开来。", "maxLength": 80 },
    { "key": "font", "label": "字体", "type": "font", "target": "css", "default": "system-sans" }
