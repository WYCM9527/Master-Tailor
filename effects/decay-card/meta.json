{
  "slug": "decay-card",
  "name": "溶解卡片",
  "category": "card",
  "sub": "hover",
  "tags": ["卡片", "扭曲", "溶解", "SVG 滤镜", "鼠标跟随"],
  "summary": "一张海报卡跟着鼠标漂移倾斜，鼠标动得越快图像越被湍流揉散，停下又慢慢凝回原样",
  "params": [
    { "key": "photo", "label": "图片", "type": "image", "target": "config", "default": "/samples/sample-4.webp" },
    { "key": "title", "label": "标题", "type": "text", "target": "config", "default": "溶解", "maxLength": 10 },
    { "key": "subtitle", "label": "副标题", "type": "text", "target": "config", "default": "动一动鼠标", "maxLength": 16 },
    {
      "key": "baseFrequency",
      "label": "湍流粒度",
      "type": "range",
      "target": "config",
      "min": 0.005,
      "max": 0.05,
      "step": 0.005,
      "default": 0.015,
      "help": "越小揉出的团块越大"
    },
    {
      "key": "numOctaves",
      "label": "湍流层数",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "key": "maxDisplacement",
      "label": "最大扭曲",
      "type": "range",
      "target": "config",
      "min": 50,
      "max": 800,
      "step": 50,
      "default": 400
    },
    {
      "key": "movementBound",
      "label": "漂移范围",
      "type": "range",
      "target": "config",
      "min": 10,
      "max": 150,
      "step": 10,
      "default": 50,
      "unit": "px"
    },
    {
      "key": "cardWidth",
      "label": "卡片宽度",
      "type": "range",
      "target": "config",
      "min": 200,
      "max": 460,
      "step": 20,
      "default": 300,
      "unit": "px"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "violent", "name": "剧烈溶解", "values": { "maxDisplacement": 700, "baseFrequency": 0.03, "movementBound": 100 } },
    { "id": "gentle", "name": "轻微涟漪", "values": { "maxDisplacement": 120, "baseFrequency": 0.008, "numOctaves": 3 } }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "visual-inspiration" }
}
