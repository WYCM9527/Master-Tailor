{
  "slug": "cursor-trail",
  "name": "鼠标流光拖尾",
  "category": "canvas",
  "sub": "hover",
  "tags": ["鼠标跟随", "流光", "拖尾"],
  "summary": "一条发光的丝带跟着鼠标游走，尾部渐渐消散",
  "params": [
    { "key": "color", "label": "流光颜色", "type": "color", "target": "css", "default": "#f9cf00" },
    {
      "key": "trailLen",
      "label": "拖尾长度",
      "type": "range",
      "target": "config",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 32,
      "help": "记录的轨迹点数量，越多尾巴越长"
    },
    {
      "key": "lineWidth",
      "label": "丝带宽度",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6,
      "unit": "px"
    },
    { "key": "glow", "label": "发光叠加", "type": "toggle", "target": "config", "default": true, "help": "用加色混合让流光更亮" },
    {
      "key": "smooth",
      "label": "跟随柔顺度",
      "type": "range",
      "target": "config",
      "min": 0.1,
      "max": 0.6,
      "step": 0.05,
      "default": 0.35,
      "help": "越小尾巴甩得越慢越飘"
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "comet",
      "name": "青色彗星",
      "values": { "color": "#00e5ff", "trailLen": 50, "lineWidth": 4, "smooth": 0.2 }
    },
    {
      "id": "brush",
      "name": "粗笔刷",
      "values": { "color": "#ff4d6d", "lineWidth": 11, "trailLen": 18, "glow": false, "smooth": 0.5 }
    }
  ],
  "thumb": { "mode": "autoplay" },
  "source": { "kind": "original" }
}
