{
  "slug": "number-count-up",
  "name": "数字滚动计数",
  "category": "text",
  "sub": "idle",
  "tags": ["数字", "计数", "数据"],
  "summary": "数字从零一路滚到目标值，先快后慢稳稳停住",
  "params": [
    {
      "key": "target",
      "label": "目标数值",
      "type": "range",
      "target": "config",
      "min": 10,
      "max": 999999,
      "step": 1,
      "default": 128500
    },
    {
      "key": "duration",
      "label": "滚动时长",
      "type": "range",
      "target": "config",
      "min": 0.5,
      "max": 6,
      "step": 0.5,
      "default": 2.5,
      "displayUnit": " 秒"
    },
    {
      "key": "ease",
      "label": "收尾方式",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "out", "label": "先快后慢" },
        { "value": "inout", "label": "慢起慢收" },
        { "value": "linear", "label": "匀速" }
      ],
      "default": "out"
    },
    {
      "key": "separator",
      "label": "千位分隔符",
      "type": "toggle",
      "target": "config",
      "default": true
    },
    {
      "key": "prefix",
      "label": "前缀",
      "type": "text",
      "target": "config",
      "default": "",
      "maxLength": 6,
      "help": "如货币符号 ¥ / $，可留空"
    },
    {
      "key": "suffix",
      "label": "后缀",
      "type": "text",
      "target": "config",
      "default": "+",
      "maxLength": 6,
      "help": "如 + / % / 人，可留空"
    },
    {
      "key": "label",
      "label": "说明文字",
      "type": "text",
      "target": "config",
      "default": "累计服务用户",
      "maxLength": 20
    },
    { "key": "color", "label": "数字颜色", "type": "color", "target": "css", "default": "#ffffff" },
    {
      "key": "fontSize",
      "label": "字号",
      "type": "range",
      "target": "css",
      "min": 32,
      "max": 120,
      "step": 4,
      "default": 72,
      "unit": "px"
    },
    { "key": "font", "label": "字体", "type": "font", "target": "css", "default": "jetbrains-mono" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "money",
      "name": "营收",
      "values": {
        "target": 980000,
        "prefix": "¥",
        "suffix": "",
        "label": "本月营收",
        "duration": 3,
        "ease": "inout"
      }
    },
    {
      "id": "percent",
      "name": "百分比",
      "values": {
        "target": 99,
        "suffix": "%",
        "separator": false,
        "label": "客户满意度",
        "duration": 1.5,
        "font": "system-sans"
      }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
