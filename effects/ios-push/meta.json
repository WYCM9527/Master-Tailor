{
  "category": "transition",
  "sub": "push",
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration",
    "name": "iOS 系统导航推屏"
  },
  "slug": "ios-push",
  "name": "iOS 推屏转场",
  "tags": ["转场", "推屏", "iOS", "View Transitions"],
  "summary": "新页右缘推入、旧页让位压暗，复刻 iPhone 系统级导航手感",
  "params": [
    {
      "key": "duration",
      "label": "转场时长",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 0.7,
      "step": 0.05,
      "default": 0.35,
      "unit": "s",
      "displayUnit": " 秒",
      "help": "iOS 系统推屏约 0.35 秒"
    },
    {
      "key": "parallax",
      "label": "旧页让位幅度",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 25,
      "unit": "",
      "displayUnit": "%",
      "help": "新页推入时旧页向左退让的距离占页宽的比例，0 为原地不动"
    },
    {
      "key": "dim",
      "label": "旧页压暗程度",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 0.3,
      "step": 0.02,
      "default": 0.1,
      "unit": "",
      "help": "0 不压暗，0.3 明显变暗，制造新页在上层的纵深感"
    },
    {
      "key": "shadow",
      "label": "新页左缘投影",
      "type": "toggle",
      "target": "css",
      "default": true
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "brisk",
      "name": "轻快",
      "values": {
        "duration": 0.3,
        "parallax": 30,
        "dim": 0.08
      }
    },
    {
      "id": "calm",
      "name": "从容",
      "values": {
        "duration": 0.5,
        "parallax": 20,
        "dim": 0.16
      }
    }
  ]
