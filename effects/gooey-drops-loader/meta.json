    {
      "key": "color",
      "label": "液滴颜色",
      "type": "color",
      "target": "css",
      "default": "#7c9cff"
    },
    {
      "key": "size",
      "label": "液滴大小",
      "type": "range",
      "target": "css",
      "min": 12,
      "max": 40,
      "step": 2,
      "default": 22,
      "unit": "px"
    },
    {
      "key": "travel",
      "label": "滑动距离",
      "type": "range",
      "target": "css",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 56,
      "unit": "px"
    },
    {
      "key": "speed",
      "label": "一轮时长",
      "type": "range",
      "target": "css",
      "min": 0.8,
      "max": 4,
      "step": 0.1,
      "default": 1.8,
      "unit": "s",
      "displayUnit": " 秒"
    },
    {
      "key": "goo",
      "label": "粘稠度",
      "type": "range",
      "target": "css",
      "min": 2,
      "max": 14,
      "step": 1,
      "default": 7,
      "unit": "px"
