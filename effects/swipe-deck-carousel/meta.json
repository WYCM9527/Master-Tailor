{
  "category": "showcase",
  "sub": "carousel",
  "thumb": {
    "mode": "autoplay"
  },
  "source": {
    "kind": "visual-inspiration",
    "name": "Tinder 式滑卡交互（通用模式）",
    "url": "https://swiperjs.com/demos",
    "license": "未使用其代码"
  },
  "slug": "swipe-deck-carousel",
  "name": "甩卡轮播",
  "tags": [
    "轮播",
    "堆叠",
    "拖拽"
  ],
  "summary": "拖住顶卡往左右甩，LIKE / NOPE 印章随手浮现",
  "params": [
    {
      "key": "slides",
      "label": "幻灯片",
      "type": "images",
      "target": "config",
      "min": 3,
      "max": 8,
      "captions": true,
      "default": [
        {
          "src": "/samples/sample-1.webp",
          "caption": "卡片一 · 夜枭小憩"
        },
        {
          "src": "/samples/sample-2.webp",
          "caption": "卡片二 · 海边老爷车"
        },
        {
          "src": "/samples/sample-3.webp",
          "caption": "卡片三 · 日落海滩"
        },
        {
          "src": "/samples/sample-4.webp",
          "caption": "卡片四 · 山谷晨光"
        },
        {
          "src": "/samples/sample-5.webp",
          "caption": "卡片五 · 蓝天夹竹桃"
        }
      ]
    },
    {
      "key": "interval",
      "label": "自动甩卡间隔",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 4,
      "displayUnit": " 秒",
      "help": "调到 0 表示不自动播放"
    },
    {
      "key": "threshold",
      "label": "甩出力度门槛",
      "type": "range",
      "target": "config",
      "min": 50,
      "max": 160,
      "step": 10,
      "default": 90,
      "unit": "px",
      "help": "拖过这个距离松手才会飞出，否则弹回"
    },
    {
      "key": "stamps",
      "label": "LIKE / NOPE 印章",
      "type": "toggle",
      "target": "config",
      "default": true
    },
    {
      "key": "likeColor",
      "label": "LIKE 颜色",
      "type": "color",
      "target": "css",
      "default": "#4ade80"
    },
    {
      "key": "nopeColor",
      "label": "NOPE 颜色",
      "type": "color",
      "target": "css",
      "default": "#ff4d6d"
    },
    {
      "key": "accent",
      "label": "强调色",
      "type": "color",
      "target": "css",
      "default": "#ffffff"
    },
    {
      "key": "rounded",
      "label": "卡片圆角",
      "type": "range",
      "target": "css",
      "min": 0,
      "max": 32,
      "step": 2,
      "default": 18,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "id": "default",
      "name": "默认",
      "values": {}
    },
    {
      "id": "easy",
      "name": "轻轻一甩",
      "values": {
        "threshold": 50,
        "interval": 3
      }
    },
    {
      "id": "plain",
      "name": "无印章纯甩",
      "values": {
        "stamps": false,
        "interval": 5,
        "rounded": 24
      }
    }
  ]
}
