{
  "slug": "letter-shuffle-in",
  "name": "字符洗牌进场",
  "category": "text",
  "sub": "idle",
  "tags": ["进场", "洗牌", "滑入", "裁切"],
  "summary": "每个字都在自己的小窗里，一条字形带从旁边滑进来、掠过几个乱字后停在正确的字上",
  "params": [
    {
      "key": "text",
      "label": "文案",
      "type": "text",
      "target": "config",
      "default": "SHUFFLE 洗牌进场",
      "maxLength": 40
    },
    {
      "key": "direction",
      "label": "滑入方向",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "right", "label": "从左向右" },
        { "value": "left", "label": "从右向左" },
        { "value": "down", "label": "从上向下" },
        { "value": "up", "label": "从下向上" }
      ],
      "default": "right"
    },
    {
      "key": "duration",
      "label": "滑入时长",
      "type": "range",
      "target": "config",
      "min": 0.15,
      "max": 1.2,
      "step": 0.05,
      "default": 0.35,
      "unit": "s"
    },
    {
      "key": "shuffleTimes",
      "label": "掠过乱字数",
      "type": "range",
      "target": "config",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1,
      "help": "停下之前带子上有几个乱字"
    },
    {
      "key": "mode",
      "label": "编排方式",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "evenodd", "label": "奇偶交错" },
        { "value": "random", "label": "随机延迟" }
      ],
      "default": "evenodd"
    },
    {
      "key": "stagger",
      "label": "相邻错开",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 0.15,
      "step": 0.01,
      "default": 0.03,
      "unit": "s"
    },
    {
      "key": "glyphs",
      "label": "乱字来源",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "self", "label": "原字本身（纯滑动）" },
        { "value": "latin", "label": "大写字母与数字" },
        { "value": "symbol", "label": "符号" }
      ],
      "default": "self"
    },
    { "key": "color", "label": "文字颜色", "type": "color", "target": "css", "default": "#f2f3f8" },
    {
      "key": "fontSize",
      "label": "字号",
      "type": "range",
      "target": "css",
      "min": 24,
      "max": 96,
      "step": 2,
      "default": 52,
      "unit": "px"
    },
    { "key": "font", "label": "字体", "type": "font", "target": "css", "default": "jetbrains-mono" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    { "id": "slot", "name": "竖排老虎机", "values": { "direction": "down", "shuffleTimes": 4, "duration": 0.6, "glyphs": "latin" } },
    { "id": "random", "name": "随机乱入", "values": { "mode": "random", "glyphs": "symbol", "shuffleTimes": 2 } }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
