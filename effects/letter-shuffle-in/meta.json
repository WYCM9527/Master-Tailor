{
  "slug": "letter-shuffle-in",
  "name": "字符洗牌进场",
  "category": "text",
  "sub": "idle",
  "tags": ["进场", "洗牌", "老虎机"],
  "summary": "每个字位先快速翻动一串乱字，再依次停在正确的字上",
  "params": [
    {
      "key": "text",
      "label": "文案",
      "type": "text",
      "target": "config",
      "default": "SHUFFLE 洗牌进场",
      "maxLength": 40
    },
    {
      "key": "rounds",
      "label": "翻动次数",
      "type": "range",
      "target": "config",
      "min": 3,
      "max": 20,
      "step": 1,
      "default": 8,
      "help": "每个字位停下之前翻过多少个乱字"
    },
    {
      "key": "speed",
      "label": "翻动速度",
      "type": "range",
      "target": "config",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 45,
      "displayUnit": " 毫秒/次"
    },
    {
      "key": "stagger",
      "label": "相邻错开",
      "type": "range",
      "target": "config",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 60,
      "displayUnit": " 毫秒",
      "help": "0 则所有字位同时开始、同时停下"
    },
    {
      "key": "glyphs",
      "label": "乱字来源",
      "type": "select",
      "target": "config",
      "options": [
        { "value": "latin", "label": "大写字母与数字" },
        { "value": "symbol", "label": "符号" },
        { "value": "self", "label": "文案自身的字" }
      ],
      "default": "latin"
    },
    { "key": "color", "label": "文字颜色", "type": "color", "target": "css", "default": "#f2f3f8" },
    {
      "key": "accent",
      "label": "翻动中颜色",
      "type": "color",
      "target": "css",
      "default": "#8a8b98"
    },
    {
      "key": "fontSize",
      "label": "字号",
      "type": "range",
      "target": "css",
      "min": 24,
      "max": 96,
      "step": 2,
      "default": 52,
      "unit": "px"
    },
    { "key": "font", "label": "字体", "type": "font", "target": "css", "default": "jetbrains-mono" }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "slot",
      "name": "老虎机",
      "values": { "rounds": 16, "speed": 30, "stagger": 120, "glyphs": "self" }
    },
    {
      "id": "burst",
      "name": "齐停",
      "values": { "rounds": 12, "speed": 40, "stagger": 0, "glyphs": "symbol", "accent": "#ffffff" }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "visual-inspiration" }
}
