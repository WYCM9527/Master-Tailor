{
  "slug": "aurora-gradient",
  "name": "极光渐变流光",
  "category": "background",
  "trigger": "idle",
  "tags": ["渐变", "氛围", "流动"],
  "summary": "缓慢流动的多色极光背景，适合首屏与登录页",
  "params": [
    { "key": "colorA", "label": "主色", "type": "color", "target": "css", "default": "#f9cf00" },
    { "key": "colorB", "label": "辅色", "type": "color", "target": "css", "default": "#7c4dff" },
    { "key": "colorC", "label": "点缀色", "type": "color", "target": "css", "default": "#00e5ff" },
    {
      "key": "speed",
      "label": "流动速度",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1,
      "unit": "",
      "displayUnit": "×",
      "help": "1× 是悠然的呼吸感，越大流动越快"
    },
    {
      "key": "blur",
      "label": "光斑柔和度",
      "type": "range",
      "target": "css",
      "min": 40,
      "max": 160,
      "step": 5,
      "default": 90,
      "unit": "px"
    },
    {
      "key": "blobs",
      "label": "光斑数量",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "cyber",
      "name": "赛博青紫",
      "values": { "colorA": "#00e5ff", "colorB": "#7c4dff", "colorC": "#ff4dff", "speed": 1.4 }
    },
    {
      "id": "sunset",
      "name": "日落暖橙",
      "values": { "colorA": "#ff9e42", "colorB": "#ff4d6d", "colorC": "#ffd166", "speed": 0.6, "blur": 120, "blobs": 4 }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "original" }
}
