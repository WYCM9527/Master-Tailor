{
  "slug": "aurora-gradient",
  "name": "极光渐变流光",
  "category": "background",
  "sub": "idle",
  "tags": ["渐变", "氛围", "流动"],
  "summary": "缓慢流动的多色极光背景，适合首屏与登录页",
  "params": [
    {
      "key": "colors",
      "label": "极光颜色",
      "type": "colors",
      "target": "config",
      "min": 2,
      "max": 8,
      "default": ["#ffffff", "#7c4dff", "#00e5ff"],
      "help": "光斑按这个顺序轮流取色，颗数多于颜色数时从头再来"
    },
    {
      "key": "speed",
      "label": "流动速度",
      "type": "range",
      "target": "css",
      "min": 0.2,
      "max": 3,
      "step": 0.1,
      "default": 1,
      "unit": "",
      "displayUnit": "×",
      "help": "1× 是悠然的呼吸感，越大流动越快"
    },
    {
      "key": "blur",
      "label": "光斑柔和度",
      "type": "range",
      "target": "css",
      "min": 40,
      "max": 160,
      "step": 5,
      "default": 90,
      "unit": "px"
    },
    {
      "key": "blobs",
      "label": "光斑数量",
      "type": "range",
      "target": "config",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    { "id": "default", "name": "默认", "values": {} },
    {
      "id": "cyber",
      "name": "赛博青紫",
      "values": { "colors": ["#00e5ff", "#7c4dff", "#ff4dff"], "speed": 1.4 }
    },
    {
      "id": "sunset",
      "name": "日落暖橙",
      "values": {
        "colors": ["#ff9e42", "#ff4d6d", "#ffd166", "#ff7a00"],
        "speed": 0.6,
        "blur": 120,
        "blobs": 4
      }
    },
    {
      "id": "rainbow",
      "name": "七彩极光",
      "values": {
        "colors": ["#ff4d6d", "#ff9e42", "#ffd166", "#4dff88", "#00e5ff", "#7c4dff", "#ff4dff"],
        "blobs": 7,
        "blur": 110
      }
    }
  ],
  "thumb": { "mode": "live" },
  "source": { "kind": "original" }
}
