  "summary": "几张白边照片像随手摊在桌上，各有倾角、层层叠压，进场时从中心依次弹出带过冲；悬停哪张它就转正浮到最上面",
  "params": [
    { "key": "slides", "label": "照片", "type": "images", "target": "config", "min": 3, "max": 8, "captions": false, "default": [{"src": "/samples/sample-1.webp", "caption": ""}, {"src": "/samples/sample-2.webp", "caption": ""}, {"src": "/samples/sample-3.webp", "caption": ""}, {"src": "/samples/sample-4.webp", "caption": ""}, {"src": "/samples/sample-5.webp", "caption": ""}] },
    { "key": "title", "label": "标题", "type": "text", "target": "config", "default": "这次旅行的照片", "maxLength": 24 },
