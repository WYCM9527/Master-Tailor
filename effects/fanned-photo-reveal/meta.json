    { "key": "loop", "label": "演示循环", "type": "toggle", "target": "config", "default": true },
    { "key": "size", "label": "照片边长", "type": "range", "target": "css", "min": 90, "max": 260, "step": 10, "default": 150, "unit": "px" },
    { "key": "overlap", "label": "重叠量", "type": "range", "target": "css", "min": 0, "max": 120, "step": 4, "default": 56, "unit": "px" },
    { "key": "frameWidth", "label": "相框宽度", "type": "range", "target": "css", "min": 0, "max": 14, "step": 1, "default": 6, "unit": "px" },
    { "key": "frame", "label": "相框颜色", "type": "color", "target": "css", "default": "#ffffff" }
  ],
  "presets": [
